<mjml>
  <mj-head>
    <mj-include path="./_theme.mjml" />
    <mj-title>Scorecard reminder</mj-title>
    <mj-preview>The scorecard for your recent match is due</mj-preview>
  </mj-head>
  <mj-body background-color="#eef0f4" width="600px">

    <mj-include path="./_header.mjml" />

    <mj-section padding="28px 0 0">
      <mj-column>
        <mj-text mj-class="kicker" text-transform="uppercase">Reminder</mj-text>
        <mj-text mj-class="h1" padding="6px 24px 0">Your scorecard is due</mj-text>
        <mj-raw><% if (matchLine) { %></mj-raw>
        <mj-text mj-class="sub" padding="4px 24px 0"><%= matchLine %></mj-text>
        <mj-raw><% } %></mj-raw>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 0 0">
      <mj-column>
        <mj-text>
          Just a timely reminder that the scorecard for your recent match is due by close
          of play tomorrow, to avoid a late card mark.
        </mj-text>
        <mj-button href="<%= submitUrl %>" css-class="cta">Enter the result</mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 0 0">
      <mj-column>
        <mj-text>Thanks,<br />Neil</mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./_footer.mjml" />
  </mj-body>
</mjml>
