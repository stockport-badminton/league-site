<mjml>
  <mj-head>
    <mj-include path="./_theme.mjml" />
    <mj-title>Scorecard received</mj-title>
    <mj-preview><%= homeTeamName %> v <%= awayTeamName %> — check the result</mj-preview>
  </mj-head>
  <mj-body background-color="#eef0f4" width="600px">

    <mj-include path="./_header.mjml" />

    <mj-section padding="28px 0 0">
      <mj-column>
        <mj-text mj-class="kicker" text-transform="uppercase">Scorecard received</mj-text>
        <mj-text mj-class="h1" padding="6px 24px 0"><%= homeTeamName %> <span style="color:#626b7d">v</span> <%= awayTeamName %></mj-text>
        <mj-text mj-class="sub" padding="4px 24px 0"><%= divisionName %> &middot; <%= matchDate %></mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 0 0">
      <mj-column>
        <mj-text><%= photoLine %></mj-text>
        <mj-button href="<%= confirmUrl %>" css-class="cta">Check the result</mj-button>
      </mj-column>
    </mj-section>

    <!-- The photo row only exists when a photo does. An EJS tag sitting directly between
         two MJML components is DISCARDED by the compiler and whatever it guarded then
         renders unconditionally — which is exactly how a photo link that always shows
         gets shipped. mj-raw is what makes the conditional survive, and
         tools/build-emails.js counts the tags to prove it did. -->
    <mj-raw><% if (photoUrl) { %></mj-raw>
    <mj-section padding="10px 0 0">
      <mj-column>
        <mj-text mj-class="muted">
          Or view the photographed card:
          <a href="<%= photoUrl %>" style="color:#002060">scorecard photo</a>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw><% } %></mj-raw>

    <!-- And when there is NO photo, who to ask for one. Same mj-raw rule as above.
         Read through `locals` so an omitted key is simply "nobody to name" rather than a
         throw. Every other value here is required and referenced bare; this one is
         optional by nature, and a bare reference would mean a caller that forgot it sends
         NO EMAIL AT ALL — swallowed by afterCommit into a handled Sentry event while the
         results secretary hears nothing. That is the failure this line is meant to help
         with, not cause.
         Only rendered without a photo: with one attached there is nothing to chase.
         Absent entirely for an anonymous submission rather than guessed at from the
         team, which would send the chase to the wrong person. -->
    <mj-raw><% if (locals.submitterEmail) { %></mj-raw>
    <mj-section padding="10px 0 0">
      <mj-column>
        <mj-text mj-class="muted">
          No photo was attached. Ask
          <a href="mailto:<%= locals.submitterEmail %>" style="color:#002060"><%= locals.submitterName || locals.submitterEmail %></a>
          for the card.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw><% } %></mj-raw>

    <mj-section padding="16px 0 0">
      <mj-column>
        <mj-text mj-class="muted" padding="0 24px 26px">
          The link above opens the card as it was filed, for checking before it is published.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./_footer.mjml" />

  </mj-body>
</mjml>
