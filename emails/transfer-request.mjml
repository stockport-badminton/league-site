<mjml>
  <mj-head>
    <mj-include path="./_theme.mjml" />
    <mj-title>Transfer request</mj-title>
    <mj-preview><%= playerName %> to <%= destTeam %></mj-preview>
  </mj-head>
  <mj-body background-color="#eef0f4" width="600px">

    <mj-include path="./_header.mjml" />

    <mj-section padding="28px 0 0">
      <mj-column>
        <mj-text mj-class="kicker" text-transform="uppercase">Transfer request</mj-text>
        <mj-text mj-class="h1" padding="6px 24px 0"><%= playerName %></mj-text>
        <mj-text mj-class="sub" padding="4px 24px 0">
          <%= requester %> at <%= requesterClub %>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 0 0">
      <mj-column>
        <mj-table>
          <tr><td style="padding:6px 10px;color:#626b7d">Player</td>
              <td style="padding:6px 10px"><strong><%= playerName %></strong> (id <%= playerId %>)</td></tr>
          <tr><td style="padding:6px 10px;color:#626b7d">Currently at</td>
              <td style="padding:6px 10px"><%= currentlyAt %></td></tr>
          <tr><td style="padding:6px 10px;color:#626b7d">Requested for</td>
              <td style="padding:6px 10px"><%= destTeam %> (<%= destClub %>)</td></tr>
        </mj-table>
        <mj-button href="<%= rosterUrl %>" css-class="cta">Approve on the roster</mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="./_footer.mjml" />
  </mj-body>
</mjml>
