<%- include('header.ejs') %>
<%- include('nav.ejs') %>

  <% if (error) { %>
    <p>Something seems to have gone wrong</p>
    <p><%= error %></p>
  <% }
  else { %>
    <table border="1">
      <thead>
        <tr>
          <th>Name</th>
          <th>Address</th>
          <th>Getting there</th>
        </tr>
      </thead>
      <tbody>
    <% result.forEach(function(row){ %>
      <tr>
          <td><%= row['name'] %></td>
          <td><a href="<%= row['gMapUrl'] %>"><%= row['address'] %></a></td>
          <td style="white-space: pre-line"><%= row['directions'] || '' %></td>
      </tr>
    <% }) %>
      </tbody>
    </table>
   <% } %>




<%- include('footer.ejs') %>


</body>
</html>
