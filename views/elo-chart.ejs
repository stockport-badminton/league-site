<%- include('header.ejs') %>
<%- include('nav.ejs') %>

<div class="col-12 p-0">

<h1>ELO Rating Chart</h1>
<p class="text-muted">Compare up to <%= maxPlayers %> players' ELO ratings over time.</p>
<%- include('ratings-explainer.ejs', { showPoints: showStrength, bands: ratingBands }) %>

<div class="row no-gutters g-0" style="min-height:calc(100vh - 200px);">

  <!-- Left panel: filters + search + player badges -->
  <div class="col-12 col-md-2 pr-md-2 pe-md-2 mb-2 mb-md-0">
    <div class="card h-100">
      <div class="card-body p-2">

        <label class="small font-weight-bold fw-bold mb-1">Filter</label>
        <select class="form-control form-control-sm mb-1" id="filter-division">
          <option value="">All divisions</option>
          <% divisions.forEach(function(d){ %>
            <option value="<%= d.name %>"><%= d.name %></option>
          <% }) %>
        </select>
        <select class="form-control form-control-sm mb-1" id="filter-club">
          <option value="">All clubs</option>
          <% clubs.forEach(function(c){ %>
            <option value="<%= c.name %>"><%= c.name %></option>
          <% }) %>
        </select>
        <select class="form-control form-control-sm mb-1" id="filter-team">
          <option value="">All teams</option>
          <% teams.forEach(function(t){ %>
            <option value="<%= t.name %>"><%= t.name %></option>
          <% }) %>
        </select>
        <select class="form-control form-control-sm mb-2" id="filter-gender">
          <option value="">All genders</option>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
        </select>

        <label for="player-search" class="small font-weight-bold fw-bold mb-1">Search for a player</label>
        <div style="position:relative;">
          <input type="text" id="player-search" class="form-control form-control-sm" placeholder="Type a name…" autocomplete="off">
          <div id="search-results" class="list-group mt-1" style="position:absolute;z-index:1000;width:100%;display:none;"></div>
        </div>
        <div id="selected-players" class="mt-2"></div>
        <% if (showStrength) { %>
        <label for="rating-mode" class="small font-weight-bold fw-bold mt-2 mb-1">Rating</label>
        <select class="form-control form-control-sm" id="rating-mode">
          <option value="elo">ELO</option>
          <option value="points">Points rating</option>
          <option value="both">Both</option>
        </select>
        <p class="small text-muted mt-1 mb-0">Points rating: admin only, weekly, dashed; the shading is ± its uncertainty. Compare men with men and ladies with ladies.</p>
        <% } %>
        <button id="clear-btn" class="btn btn-sm btn-outline-secondary mt-2 w-100">Clear all</button>
      </div>
    </div>
  </div>

  <!-- Right panel: chart -->
  <div class="col-12 col-md-10">
    <div class="card h-100">
      <div class="card-body p-2" style="position:relative;min-height:500px;">
        <canvas id="elo-chart"></canvas>
      </div>
    </div>
  </div>

</div>

</div><!-- /col-12 -->

<%- include('footer.ejs') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3/dist/chartjs-adapter-date-fns.bundle.min.js"></script>

<script type="application/json" id="elo-chart-config"><%- JSON.stringify({
  maxPlayers: maxPlayers,
  showStrength: !!showStrength,
  selectedIds: String(selectedIds || '').split(',').map(Number).filter(Boolean)
}) %></script>
<script src="<%= asset('/static/beta/js/elo-compare.js') %>"></script>

</body>
</html>
