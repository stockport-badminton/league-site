<!-- DataTables library tags. Shared by datatables.ejs (results/fixture tables) and
     datatables-stats.ejs (stats tables) so the CDN URLs are declared in one place.
     Six views each carried their own copy, and they had drifted: three asked for a
     bundle with b-html5 (the CSV button) and three for one without, so the browser
     fetched two different 200KB+ bundles across a session.

     Note there is no `jq-` segment in the URL. The bundle used to include jQuery
     3.3.1, which was fetched on top of the copy footer.ejs already self-hosts from
     node_modules, then replaced window.jQuery with a second instance that carries
     none of the Bootstrap plugins registered on the first. Excluding it drops the
     bundle from 220KB to 158KB and leaves one jQuery on the page.

     Views opt into the matching CSS with include('header.ejs', { useDataTables: true }). -->
<script type="text/javascript" src="https://cdn.datatables.net/v/bs4/dt-1.10.20/b-1.6.1/b-colvis-1.6.1/b-html5-1.6.1/fh-3.1.6/r-2.2.3/datatables.min.js"></script>
<script type="text/javascript" src="//cdn.datatables.net/plug-ins/1.10.19/sorting/date-euro.js"></script>
