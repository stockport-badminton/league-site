<!-- Stats tables (player-stats, pair-stats, player-list, missed-three-list).
     All four get the same DataTable - orderCellsTop + fixedHeader on
     #results-table, plus the shared control band and a Columns dropdown - and
     two optional extras:

       include('datatables-stats.ejs', { dtColumnSearch: true })  per-column search row
       include('datatables-stats.ejs', { dtCsv: true })           Download CSV button

     Each view carried its own near-identical copy of this before, three of them
     with the per-column search row permanently visible - doubling the header
     height and reading like a data row.

     Results/fixture tables use datatables.ejs instead. Both share
     datatables-scripts.ejs for the library tags and static/beta/js/datatables-setup.js
     for the table itself, configured by the JSON block below. -->
<%- include('datatables-scripts.ejs') %>

<script type="application/json" id="dt-config"><%- JSON.stringify({
  kind: 'stats',
  csv: typeof dtCsv !== 'undefined' && !!dtCsv,
  columnSearch: typeof dtColumnSearch !== 'undefined' && !!dtColumnSearch,
  icons: { eye: icon('eye'), download: icon('download'), search: icon('magnifying-glass') }
}).replace(/</g, '\\u003c') %></script>
<script defer src="<%= asset('/static/beta/js/datatables-setup.js') %>"></script>
<% if (typeof filter !== 'undefined' && filter == true){ %>
<script src="<%= asset('/static/beta/js/filters.js') %>"></script>
<% } %>
