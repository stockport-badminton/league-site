<%#
  One team's registrations. Shared by roster.ejs (read-only) and roster-edit.ejs so
  the two views can't drift apart — the old page achieved that by being a single
  template with the controls wrapped in `if (superadmin)`, which meant the captain
  read a layout designed entirely around drop targets.

  Locals:
    team      — a card from rosterController.groupByTeam
    editable  — render drag handles and the row menu
    contacts  — render tap-to-call / mail links

  player.rank is per (team, gender): a team's number 1 man and number 1 lady both
  hold rank 1, so men and ladies are separate numbered lists rather than one
  merged one. `position` is the display index within its own list, which is what
  gets shown — the stored rank can have gaps (there are live teams ranked 1, 2, 4,
  6 from the old client-side renumbering) and saving normalises them.
%>
<div class="roster-card" data-team-id="<%= team.id %>" data-team-name="<%= team.name %>">
  <div class="roster-card-head">
    <h2 class="team-name"><%= team.name %></h2>
    <% if (team.divisionName) { %>
      <span class="division"><%= team.divisionName %></span>
    <% } %>
    <span class="spacer"></span>
    <span class="team-count">
      <%= team.counts.nominated %> nominated<% if (team.counts.reserve) { %> · <%= team.counts.reserve %> reserve<% } %>
    </span>
  </div>

  <div class="roster-genders">
    <% ['Male', 'Female'].forEach(function(gender) {
         const genderLabel = gender === 'Male' ? 'Men' : 'Ladies';
    %>
      <div class="roster-gender">
        <div class="roster-section-label">
          <span>Nominated <%= genderLabel %></span>
          <span><%= team.nominated[gender].length %></span>
        </div>
        <ul class="roster-list<%= team.nominated[gender].length ? '' : ' is-empty-target' %>"
            data-team="<%= team.id %>" data-gender="<%= gender %>" data-section="nominated">
          <% team.nominated[gender].forEach(function(player) { %>
            <%- include('roster-row.ejs', { player: player, editable: editable, contacts: contacts, reserve: false }) %>
          <% }) %>
        </ul>
        <% if (!team.nominated[gender].length && !editable) { %>
          <p class="roster-empty">None nominated</p>
        <% } %>

        <div class="roster-section-label">
          <span>Reserve <%= genderLabel %></span>
          <span><%= team.reserve[gender].length %></span>
        </div>
        <ul class="roster-list<%= team.reserve[gender].length ? '' : ' is-empty-target' %>"
            data-team="<%= team.id %>" data-gender="<%= gender %>" data-section="reserve">
          <% team.reserve[gender].forEach(function(player) { %>
            <%- include('roster-row.ejs', { player: player, editable: editable, contacts: contacts, reserve: true }) %>
          <% }) %>
        </ul>
        <% if (!team.reserve[gender].length && !editable) { %>
          <p class="roster-empty">No reserves</p>
        <% } %>

        <% if (editable) { %>
          <div class="roster-add">
            <button type="button" class="btn btn-sm btn-outline-success roster-add-btn"
                    data-team="<%= team.id %>" data-team-name="<%= team.name %>"
                    data-gender="<%= gender %>">
              <i class="fa fa-user-plus" aria-hidden="true"></i>
              Add <%= gender === 'Male' ? 'a man' : 'a lady' %>
            </button>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>
