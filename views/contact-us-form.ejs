<%- include('header.ejs') %>

<%- include('nav.ejs') %>

<form role="form" id="contactUs" action="/contact-us" method="post">
  <div class="form-group">
    <label for="contactType">Are you trying to get in touch with a committee member of a specific club?</label>
    <%# ?junior=<id>, from the junior clubs page, arrives with Junior Clubs chosen and
        that club selected. %>
    <% var juniorChosen = typeof selectedJuniorClub !== 'undefined' && !!selectedJuniorClub; %>
    <select class="form-control" name="contactType" id="contactType">
      <option disabled <%= juniorChosen ? '' : 'selected' %>>Choose..</option>
      <option value="Clubs">Club Secretaries</option>
      <option value="League">League Representatives</option>
      <% if (juniorClubs.length) { %>
        <option value="JuniorClub" <%= juniorChosen ? 'selected' : '' %>>Junior Clubs</option>
      <% } %>
    </select>
  </div>
  <div class="form-group d-none" id="clubsDropDown">
    <label for="clubSelect">Which club are you contacting?</label>
    <%# selectedClub arrives from ?club=<id>, which the club pages link with, so
        arriving from a club page has that club already chosen. %>
    <select class="form-control" id="clubSelect" name="clubSelect">
      <option disabled <%= typeof selectedClub === 'undefined' || !selectedClub ? 'selected' : '' %>>Choose a Club</option>
      <% clubs.forEach(function(row){ %>
        <option value="<%= row['id'] %>" <%= (typeof selectedClub !== 'undefined' && String(selectedClub) === String(row['id'])) ? 'selected' : '' %>><%= row['name'] %></option>
      <% }) %>
    </select>
  </div>
  <div class="form-group <%= juniorChosen ? 'd-block' : 'd-none' %>" id="juniorClubsDropDown">
    <label for="juniorClubSelect">Which junior club are you contacting?</label>
    <select class="form-control" id="juniorClubSelect" name="juniorClubSelect">
      <option disabled <%= juniorChosen ? '' : 'selected' %>>Choose a Junior Club</option>
      <% juniorClubs.forEach(function(row){ %>
        <option value="<%= row.id %>" <%= juniorChosen && String(selectedJuniorClub) === String(row.id) ? 'selected' : '' %>><%= row.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="form-group d-none" id="leagueDropDown">
    <label for="leagueSelect">Which committee member are you contacting</label>
    <select name="leagueSelect" id="leagueSelect" class="form-control">
      <option disabled selected>Choose...</option>
      <option value="league">League Secretary</option>
      <option value="results">Results Secretary</option>
      <option value="tournament">Tournament Secretary</option>
      <option value="messer">Messer Secretary</option>
      <option value="juniors">Juniors Secretary</option>
      <option value="juniortournament">Junior Tournaments Secretary</option>
      <option value="chair">Chair</option>
      <option value="treasurer">Treasurer</option>
    </select>
  </div>
  <div class="form-group">
    <label for="contactEmail">Email address</label>
    <input type="email" class="form-control" id="contactEmail" name="contactEmail" aria-describedby="emailHelp" placeholder="Enter email">
    <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
  </div>
  <div class="form-group">
    <label for="contactQuery">Message that you want to send to the club contact</label>
    <textarea class="form-control" id="contactQuery" name="contactQuery" rows="3"></textarea>
  </div>
  
  <%- include('spam-fields.ejs') %>

  <button type="submit" class="btn btn-primary g-recaptcha" 
          data-sitekey="<%= recaptcha %>" 
          data-callback="onSubmit" 
          data-action="submit">
    Submit
  </button>
</form>

<%- include('footer.ejs') %>

<script type="text/javascript">

   function onSubmit(token) {
    // Submit the form after reCAPTCHA verification
    document.getElementById("contactUs").submit();
  }
 
  $(document).ready(function(){
    $('#contactType').change(function(){
      var shown = { Clubs: '#clubsDropDown', League: '#leagueDropDown', JuniorClub: '#juniorClubsDropDown' };
      var chosen = shown[$('#contactType').val()];
      $.each(shown, function(type, sel) {
        $(sel).attr('class', 'form-group ' + (sel === chosen ? 'd-block' : 'd-none'));
      });
    })
    $('.click').click(function(){
      console.log($(this).attr('data-club'))
    })
  })
</script>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>

</body>
</html>
