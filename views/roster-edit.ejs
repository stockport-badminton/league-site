<%- include('header.ejs', { useRosterCss: true }) %>
<%- include('nav.ejs') %>

<%#
  The editor. Everything the old drag-and-drop did, plus the things it only
  pretended to do — Move up / Move down were never wired to a handler, and reserve
  order was draggable but unsaveable.

  Three ways to reorder, because a results secretary doing this on a phone had none
  at all before: drag a handle (pointer events, so mouse/touch/pen alike), the row
  menu, or the arrow keys while a handle is focused. Cross-team moves are a
  destination list rather than a drag, since the target is usually off-screen.

  Nothing is written until Save. static/beta/js/roster-edit.js posts one request per
  changed team to /api/teams/:id/order and the server renumbers both ends of every
  move in a transaction.
%>

<div class="roster-page" id="roster-editor"
     data-club="<%= clubName %>"
     data-club-url="<%= encodeURIComponent(clubName) %>">

  <div class="roster-head">
    <div>
      <h1>Manage <%= clubName %></h1>
      <div class="roster-sub">
        Drag a handle, use the row menu, or focus a handle and press
        <kbd>&uarr;</kbd>/<kbd>&darr;</kbd>. Changes are saved when you press Save.
      </div>
    </div>
    <div class="roster-actions">
      <% if (isSuperAdmin && clubs && clubs.length > 1) { %>
        <select class="form-control form-control-sm" id="club-switch" aria-label="Switch club"
                style="width:auto">
          <% clubs.forEach(function(name) { %>
            <option value="<%= encodeURIComponent(name) %>" <%= name === clubName ? 'selected' : '' %>><%= name %></option>
          <% }) %>
        </select>
      <% } %>
      <a class="btn btn-outline-secondary btn-sm"
         href="/manage-players/club-<%= encodeURIComponent(clubName) %>">
        <i class="fa fa-eye" aria-hidden="true"></i> Roster view
      </a>
      <a class="btn btn-outline-secondary btn-sm"
         href="/manage-players/club-<%= encodeURIComponent(clubName) %>/registration.docx">
        <i class="fa fa-download" aria-hidden="true"></i> Registration form
      </a>
    </div>
  </div>

  <div class="roster-summary">
    <div class="roster-stat"><span class="n"><%= summary.players %></span><span class="l">Players</span></div>
    <div class="roster-stat"><span class="n"><%= summary.teams %></span><span class="l">Teams</span></div>
    <div class="roster-stat"><span class="n"><%= summary.nominated %></span><span class="l">Nominated</span></div>
    <div class="roster-stat"><span class="n"><%= summary.reserves %></span><span class="l">Reserves</span></div>
    <% if (summary.juniors) { %>
      <div class="roster-stat"><span class="n"><%= summary.juniors %></span><span class="l">Juniors</span></div>
    <% } %>
  </div>

  <div class="roster-grid">
    <% teamCards.forEach(function(team) { %>
      <%- include('roster-team-card.ejs', { team: team, editable: true, contacts: false }) %>
    <% }) %>
  </div>

  <div class="roster-savebar" id="roster-savebar" hidden>
    <span class="msg" id="roster-savebar-msg">1 change</span>
    <span class="spacer"></span>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="roster-discard">Discard</button>
    <button type="button" class="btn btn-sm btn-primary" id="roster-save">Save changes</button>
  </div>
</div>

<%# Destinations for a cross-team move. Rendered from the club's full team list so a
    brand new team with no players in it is still a valid target. %>
<div class="modal" id="rosterMoveModal" tabindex="-1" role="dialog" aria-labelledby="rosterMoveTitle">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="rosterMoveTitle">Move player</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p class="text-muted small" id="rosterMoveWho"></p>
        <div class="form-group">
          <label for="rosterMoveTeam">Team</label>
          <select class="form-control" id="rosterMoveTeam">
            <% moveTargets.forEach(function(t) { %>
              <option value="<%= t.id %>"><%= t.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="rosterMoveSection">Position</label>
          <select class="form-control" id="rosterMoveSection">
            <option value="nominated">Nominated</option>
            <option value="reserve" selected>Reserve</option>
          </select>
        </div>
        <p class="text-muted small mb-0">
          The move is applied immediately and both teams are renumbered.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="rosterMoveConfirm">Move player</button>
      </div>
    </div>
  </div>
</div>

<%# Add a player. The three outcomes the old modal hid behind one Add button — and
    behind an undocumented property set on an <option> element — are three labelled
    actions here. %>
<div class="modal" id="rosterAddModal" tabindex="-1" role="dialog" aria-labelledby="rosterAddTitle">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="rosterAddTitle">Add a player</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body roster-finder">
        <p class="text-muted small" id="rosterAddTarget"></p>

        <div class="form-group">
          <label for="rosterAddSearch">Search by name</label>
          <div class="input-group">
            <input type="text" class="form-control" id="rosterAddSearch"
                   placeholder="Surname or first name" autocomplete="off">
            <div class="input-group-append">
              <button class="btn btn-outline-secondary" type="button" id="rosterAddSearchBtn">Search</button>
            </div>
          </div>
          <small class="form-text text-muted">
            Searches the whole league, so you can see whether someone is already registered.
          </small>
        </div>

        <div id="rosterAddResults" aria-live="polite"></div>

        <hr>

        <div class="result-group">
          <h6>Or create a new player</h6>
          <div class="form-row">
            <div class="col-sm-5 mb-2">
              <label class="sr-only" for="rosterNewFirst">First name</label>
              <input type="text" class="form-control" id="rosterNewFirst" placeholder="First name" maxlength="60">
            </div>
            <div class="col-sm-5 mb-2">
              <label class="sr-only" for="rosterNewFamily">Family name</label>
              <input type="text" class="form-control" id="rosterNewFamily" placeholder="Family name" maxlength="60">
            </div>
            <div class="col-sm-2 mb-2">
              <button type="button" class="btn btn-success btn-block" id="rosterCreateBtn">Create</button>
            </div>
          </div>
          <small class="form-text text-muted">
            Search first — creating a duplicate splits a player's match history and ELO.
          </small>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="roster-toast" id="roster-toast" role="status" aria-live="polite"></div>

<%- include('footer.ejs') %>
<script src="<%= static_path %>/beta/js/roster-edit.js"></script>
</body>
</html>
