<%- include('header.ejs', { useMesserDrawCss: true }) %>
<%- include('nav.ejs') %>

<h1>Messer Trophy <%= section + " section" %></h1>

<% if (locals.swapped != null && teams[swapped]) { %>
  <div class="alert alert-success">
    Swapped: <%= teams[swapped].homeTeam %> are now at home to <%= teams[swapped].awayTeam %>.
    Any earlier match feeding it now sends its winner to the other side, so each winner
    still meets the same opponent.
  </div>
<% } %>
<% var swapMessages = {
     played: "That match already has a result, so home and away can't be swapped.",
     pending: 'A scorecard for that match is waiting for approval the way round it is now. Approve or reject it on Messer Results first.',
     empty: 'Neither side of that match has a team yet, so there is nothing to swap.',
     missing: "That match wasn't found in this section."
   };
   if (locals.swapError && Object.prototype.hasOwnProperty.call(swapMessages, swapError)) { %>
  <div class="alert alert-danger">
    <%= swapMessages[swapError] %>
    <% if (swapError === 'pending') { %><a href="/messer-results">Messer Results</a><% } %>
  </div>
<% } %>

<% if (locals.conceded != null && teams[conceded] && teams[conceded].concededBy) {
     var cm = teams[conceded];
     var quitter = cm.concededBy === 'home' ? cm.homeTeam : cm.awayTeam;
     var through = cm.concededBy === 'home' ? cm.awayTeam : cm.homeTeam; %>
  <div class="alert alert-success">
    Conceded: <%= quitter %> concede to <%= through %>, recorded 15-0.
    <% if (notAdvanced) { %>
      <%= through %> could not be put into the next round automatically (this is a final, or
      the next match already has a result), so check the draw.
    <% } else { %>
      <%= through %> go through to the next round.
    <% } %>
  </div>
<% } %>
<% if (locals.undone != null && teams[undone]) { %>
  <div class="alert alert-success">
    Concession undone: <%= teams[undone].homeTeam %> v <%= teams[undone].awayTeam %> is unplayed
    again, and the winner has been taken back out of the next round.
  </div>
<% } %>
<% var concedeMessages = {
     played: "That match already has a result from a scorecard, so it can't be conceded. Correct it on Messer Results instead.",
     pending: 'A scorecard for that match is waiting for approval. Approve or reject it on Messer Results first.',
     empty: 'Both sides need a team before the match can be conceded.',
     'next-played': 'The next-round match already has a result, so this concession can no longer be changed or undone.',
     'not-conceded': "That match wasn't conceded, so there is nothing to undo.",
     missing: "That match wasn't found in this section."
   };
   if (locals.concedeError && Object.prototype.hasOwnProperty.call(concedeMessages, concedeError)) { %>
  <div class="alert alert-danger">
    <%= concedeMessages[concedeError] %>
    <% if (concedeError === 'pending' || concedeError === 'played') { %><a href="/messer-results">Messer Results</a><% } %>
  </div>
<% } %>

<%#
  The bracket is drawn on a grid of 16 rows (--u tall each, in messer-draw.css). A
  section's matches have fixed drawPos numbers, so each one has a fixed place: round 2's
  eight matches take two rows each, round 3's four take four, round 4's two take eight,
  and each box is centred on its rows. Round 1's two preliminary matches each feed one
  side of a round 2 match (drawPos 1 the away side of 6, 2 the home side of 7), so each
  sits level with the line it feeds. Section B numbers from 17.
%>
<%
  var offset = (section == 'A' ? 0 : 16);
  var named = function (n) { return n && n !== 'No Team'; };
  // Round 1 is drawn only for a preliminary with a team in it; with none, the column goes.
  var prelims = [{ pos: 1, cy: 7, feeds: 'away' }, { pos: 2, cy: 9, feeds: 'home' }].filter(function (p) {
    var m = teams[p.pos + offset];
    return m && (named(m.homeTeam) || named(m.awayTeam));
  });
  var firstRound = prelims.length ? 1 : 2;
  var place = function (col, cy) { return '--col: ' + (col - (firstRound - 1)) + '; --cy: ' + cy; };
%>
<p class="d-md-none w-100 text-muted small">Scroll sideways to see the later rounds.</p>
<div class="md-scroll">
  <div class="md-draw" style="--cols: <%= 5 - firstRound %>">
    <div class="md-rounds">
      <% for (var r = firstRound; r <= 4; r++) { %><div class="md-round">Round <%= r %></div><% } %>
    </div>
    <div class="md-bracket">
      <% prelims.forEach(function (p) { %>
        <%- include('partials/messer-draw-match', { m: teams[p.pos + offset], section: section, place: place(0, p.cy), extraClass: 'md-prelim md-feeds-' + p.feeds }) %>
      <% }) %>
      <%# Rounds 2-4: each match is `span` rows tall, and each pair is joined to the
          match it feeds in the next round. %>
      <% [{ col: 1, first: 3, count: 8 }, { col: 2, first: 11, count: 4 }, { col: 3, first: 15, count: 2 }].forEach(function (c) {
           var span = 16 / c.count;
           for (var k = 0; k < c.count; k++) { %>
        <%- include('partials/messer-draw-match', { m: teams[c.first + k + offset], section: section, place: place(c.col, span * k + span / 2) }) %>
        <% if (c.col < 3 && k % 2 === 0) { %>
          <div class="md-join" style="<%= place(c.col, span * k + span / 2) %>; --span: <%= span %>"></div>
        <% } %>
      <% } }) %>
    </div>
  </div>
</div>

<% if (locals.mayAdminDraw) { %>
<%# One modal for every match's Concede button; the script below fills it from the button
    that opened it. Posts to /messer-draw/:section/concede/:id (Fixture.concedeMesserMatch). %>
<div class="modal fade" id="concedeModal" tabindex="-1" role="dialog" aria-labelledby="concedeModalTitle" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <form method="POST" class="modal-content" id="concedeForm" action="" data-section="<%= section.toLowerCase() %>">
      <div class="modal-header">
        <h5 class="modal-title" id="concedeModalTitle">Record a concession</h5>
        <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      </div>
      <div class="modal-body text-left text-start">
        <p id="concedeMatch" class="font-weight-bold fw-bold"></p>
        <p>Which side conceded? The other side wins 15-0 and goes through to the next round.</p>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="concededBy" id="concedeHome" value="home" required>
          <label class="form-check-label" for="concedeHome"></label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="concededBy" id="concedeAway" value="away">
          <label class="form-check-label" for="concedeAway"></label>
        </div>
        <div class="form-check mt-2" id="concedeUndoRow">
          <input class="form-check-input" type="radio" name="concededBy" id="concedeNone" value="none">
          <label class="form-check-label" for="concedeNone">Neither: undo the concession, and take the winner back out of the next round</label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<%- include('footer.ejs') %>
<% if (locals.mayAdminDraw) { %>
<script src="<%= asset('/static/beta/js/messer-concede.js') %>"></script>
<% } %>


</body>
</html>
