<%- include('header.ejs', { useDataTables: true }) %>
<%- include('nav.ejs') %>


  <% if (typeof errors !== 'undefined') { %>
    <p>Something seems to have gone wrong</p>
    <p><%= error %></p>
  <% }
  else { %>
    <h1>Players that have missed three matches</h1>
    <% if (sent) { %>
      <div class="alert alert-success" role="status">Sent: <%= sent %>. A copy went to the results mailbox.</div>
    <% } %>
    <div class="dt-table-shell">
    <table class="table" id="results-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Team</th>
          <th>Gender</th>
          <th>Club</th>
        </tr>
      </thead>
      <tbody>
    <% result.forEach(function(row){ %>
      <tr>
          <td><%= row['first_name'] %> <%= row['family_name'] %></td>
          <td><%= row['team_name'] %></td>
          <td><%= row['gender'] %></td>
          <td>
            <% if (row.canNotify) { %>
              <a class="btn btn-sm btn-outline-primary" href="/missed-three/<%= row.playerID %>/notice">Preview email</a>
            <% } else { %>
              <span class="text-muted">No secretary email on file</span>
            <% } %>
          </td>
      </tr>
    <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
   <% } %>




<%- include('footer.ejs') %>
<%- include('datatables-stats.ejs', { dtColumnSearch: true }) %>

</body>
</html>
