<%- include('header.ejs', { useDataTables: true }) %>
<%- include('nav.ejs') %>


  <% if (typeof errors !== 'undefined') { %>
    <p>Something seems to have gone wrong</p>
    <p><%= error %></p>
  <% }
  else { %>
    <h1>Registered Players</h1>
    <div class="dt-table-shell">
    <table class="table" id="results-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Team</th>
          <th>Gender</th>
        </tr>
      </thead>
      <tbody>
    <% result.forEach(function(row){ %>

      <tr>

          <td><a href="/remindPlayer/<%= row['playerID'] %>/<%= row['first_name'] %>|<%= row['family_name'] %>"><%= row['first_name'] %> <%= row['family_name'] %></a></td>
          <td><%= row['team_name'] %></td>
          <td><%= row['gender'] %></td>
      </tr>
    <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
   <% } %>




<%- include('footer.ejs') %>
<%- include('datatables-stats.ejs', { dtColumnSearch: true }) %>

</body>
</html>
