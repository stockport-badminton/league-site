<!-- Results/fixture tables: date-sorted on column 0 and paged to the nearest date.
     Stats tables use datatables-stats.ejs instead. Optional extra:

       include('datatables.ejs', { dtCsv: true })   Download CSV button -->
<%- include('datatables-scripts.ejs') %>

<script type="application/json" id="dt-config"><%- JSON.stringify({
  kind: 'results',
  csv: typeof dtCsv !== 'undefined' && !!dtCsv,
  // Read, never assigned: `nearestDate = new Date()` here used to create a global, so
  // every later page without one jumped to the day this instance first rendered it.
  nearestDate: String(typeof nearestDate !== 'undefined' ? nearestDate : new Date()),
  icons: { eye: icon('eye'), download: icon('download') }
}).replace(/</g, '\\u003c') %></script>
<script defer src="<%= asset('/static/beta/js/datatables-setup.js') %>"></script>
