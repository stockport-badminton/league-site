<%- include('../header.ejs') %>
<%- include('../nav.ejs') %>
<%# The monthly login cull's review (controllers/authCullController.js, docs/login-cull.md). %>
<style>
  /* .starter-template centres every page (header.ejs); tables and lists read left. */
  .lc-page, .lc-page th, .lc-page td { text-align: left; }
</style>

<div class="col-12 lc-page">
  <h1>Login Cull</h1>
  <% if (flash) { %>
    <div class="alert alert-info"><%= flash %></div>
  <% } %>

  <p class="text-muted">
    Once a month, our logins that have gone a year without being used get an email. Logging in
    to either league's site, or the link in the email, keeps them. A month after the email they
    are listed here for you to delete. Ours means linked to a player here by address, or not
    linked to anyone and not signed up on Tameside's site; anything Tameside has linked to one
    of its players is Tameside's to cull.
  </p>

  <% if (!cull) { %>
    <div class="alert alert-warning">Could not build the cull list: <%= cullError %></div>
  <% } else { %>
    <% if (cull.notify.length) { %>
      <p><strong><%= cull.notify.length %></strong> will get the email at the next monthly run.</p>
    <% } %>

    <h2 class="h4 mt-4">Due for deletion (<%= cull.due.length %>)</h2>
    <% if (cull.due.length) { %>
      <form method="post" action="/admin/login-cull/delete">
        <div class="table-responsive">
          <table class="table table-sm">
            <thead><tr><th>Login</th><th>Player</th><th>Last used</th><th>Why</th><th></th></tr></thead>
            <tbody>
              <% cull.due.forEach(function (e) { %>
                <tr>
                  <td><code><%= e.account.email || e.account.user_id %></code>
                    <input type="hidden" name="userId" value="<%= e.account.user_id %>"></td>
                  <td><%= e.player ? (e.player.first_name + ' ' + e.player.family_name) : '—' %>
                    <span class="small text-muted"><%= e.player ? (e.player.clubName || '') + (e.player.role ? ', ' + e.player.role : '') : '' %></span></td>
                  <td class="small"><%= e.lastActive %></td>
                  <td class="small text-muted"><%= e.reason %><%= e.notified ? ' (emailed ' + e.notified + ')' : '' %></td>
                  <td><button type="submit" class="btn btn-link btn-sm p-0" form="keep-<%= e.account.user_id %>">keep</button></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <button type="submit" class="btn btn-danger"
                onclick="return confirm('Delete <%= cull.due.length %> login(s) from Auth0? They are gone from Tameside\'s site too.')">
          Delete <%= cull.due.length %> <%= cull.due.length === 1 ? 'login' : 'logins' %>
        </button>
        <span class="small text-muted ml-2">From Auth0, which Tameside's site shares, and as a player's login address here. Results are untouched.</span>
      </form>
      <% cull.due.forEach(function (e) { %>
        <form id="keep-<%= e.account.user_id %>" method="post" action="/admin/login-cull/keep">
          <input type="hidden" name="userId" value="<%= e.account.user_id %>">
        </form>
      <% }); %>
    <% } else { %>
      <p class="text-success">Nothing due for deletion.</p>
    <% } %>

    <% if (cull.waiting.length) { %>
      <h2 class="h4 mt-4">Emailed, waiting (<%= cull.waiting.length %>)</h2>
      <ul class="small">
        <% cull.waiting.forEach(function (e) { %>
          <li><code><%= e.account.email %></code>
            <%= e.player ? '→ ' + e.player.first_name + ' ' + e.player.family_name : '' %>,
            emailed <%= e.notified %>, listed here from <%= e.expires %></li>
        <% }); %>
      </ul>
    <% } %>
  <% } %>
</div>

<%- include('../footer.ejs') %>
