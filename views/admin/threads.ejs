<%- include('../header.ejs') %>
<%- include('../nav.ejs') %>

<div class="col-12">
  <h1>Threads</h1>

  <p>
    Connects the league's Threads account so the site can post to it. A Threads token lasts
    60 days. It is refreshed every week, and the Monday data-health email says if that has
    stopped working. <strong>If it ever lapses, this page is how to reconnect.</strong>
  </p>

  <% if (notice) { %>
    <div class="alert alert-<%= notice[0] %>"><%= notice[1] %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <% if (missing.length) { %>
    <div class="alert alert-warning">
      <strong>Not configured.</strong> These are unset on this server:
      <code><%= missing.join(', ') %></code>.
      <% if (missing.includes('META_THREADS_USER_ID')) { %>
        The user id is what stops a login for the wrong account being stored.
      <% } %>
    </div>
  <% } %>

  <h2 class="h4 mt-4">Status</h2>
  <% if (!row) { %>
    <p>No account is connected.</p>
  <% } else { %>
    <%
      var fmt = function (d) {
        return d ? new Date(d).toLocaleString('en-GB', { timeZone: 'Europe/London',
          day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—';
      };
      var wrongAccount = expectedId && row.accountId !== expectedId;
    %>
    <table class="table table-sm" style="max-width: 40rem">
      <tr><th>Account</th>
          <td>@<%= row.username || '?' %> <span class="text-muted">(<%= row.accountId %>)</span>
            <% if (wrongAccount) { %><span class="badge badge-danger">not the configured account</span><% } %>
          </td></tr>
      <tr><th>Token issued</th><td><%= fmt(row.obtainedAt) %></td></tr>
      <tr><th>Expires</th>
          <td><%= fmt(row.expiresAt) %>
            <% if (daysLeft !== null) { %>
              <span class="badge <%= daysLeft < 0 ? 'badge-danger' : daysLeft < 45 ? 'badge-warning' : 'badge-success' %>">
                <%= daysLeft < 0 ? 'expired' : daysLeft + ' days left' %>
              </span>
            <% } %>
          </td></tr>
      <tr><th>Last refreshed</th><td><%= row.refreshedAt ? fmt(row.refreshedAt) : 'not since the last login' %></td></tr>
      <% if (row.lastError) { %>
        <tr class="table-danger"><th>Last attempt failed</th>
            <td><%= fmt(row.lastErrorAt) %>: <%= row.lastError %></td></tr>
      <% } %>
      <tr><th>Changed by</th><td><%= row.updatedBy || '—' %></td></tr>
    </table>
  <% } %>

  <div class="mt-3">
    <% if (!missing.length) { %>
      <a class="btn btn-primary" href="/admin/threads/connect"><%= row ? 'Reconnect' : 'Connect' %></a>
    <% } %>
    <% if (row) { %>
      <form method="post" action="/admin/threads/refresh" class="d-inline">
        <input type="hidden" name="from" value="page">
        <button type="submit" class="btn btn-outline-secondary">Refresh now</button>
      </form>
    <% } %>
  </div>

  <h2 class="h4 mt-5">Before pressing Connect</h2>
  <ul>
    <li><strong>Sign in to Threads as the league in this browser.</strong> Threads connects
      whichever account is signed in, and a login for anyone else is refused.</li>
    <li>The account has to be a <em>Threads</em> Tester on the app and have accepted the
      invite (Threads app → Settings → Account → Website permissions → Invites). The
      Instagram Tester role does not count.</li>
    <li>Threads sends you back to <code><%= redirectUri %></code>, which has to be listed
      exactly under the app's Threads redirect URIs.</li>
  </ul>
</div>

<%- include('../footer.ejs') %>
