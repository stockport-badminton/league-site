<%- include('../header.ejs') %>
<%- include('../nav.ejs') %>

<%# `data` is what the fields show: the stored row, or what was submitted when a save
    failed, so nothing typed is lost. %>
<% var v = function(k) { return data[k] == null ? '' : data[k]; }; %>
<div class="col-12 text-left text-start">
  <h1><%= venue ? 'Edit' : 'New' %> Venue</h1>

  <% if (errors.length) { %>
    <div class="alert alert-danger" role="alert">
      <% errors.forEach(function(e){ %><div><%= e %></div><% }) %>
    </div>
  <% } %>

  <form method="post" action="<%= venue ? '/admin/venues/' + venue.id : '/admin/venues' %>">
    <div class="form-group mb-3">
      <label for="name">Name</label>
      <input type="text" class="form-control" id="name" name="name" maxlength="45" value="<%= v('name') %>" required>
    </div>

    <div class="form-group mb-3">
      <label for="address">Address</label>
      <input type="text" class="form-control" id="address" name="address" maxlength="255" value="<%= v('address') %>" required>
      <small class="form-text text-muted">The postal address only, ending with the postcode. It is what search engines and AI assistants read as the address, so entrance and parking notes go in "Getting there" below.</small>
    </div>

    <div class="form-group mb-3">
      <label for="directions">Getting there</label>
      <textarea class="form-control" id="directions" name="directions" rows="4" maxlength="1000"><%= v('directions') %></textarea>
      <small class="form-text text-muted">Optional. Which entrance, where to park, which building, a better postcode for sat-nav. Shown under the address on event pages, club pages and the clubs map. Plain text; line breaks are kept.</small>
    </div>

    <div class="form-group mb-3">
      <label for="gMapUrl">Map link</label>
      <input type="text" class="form-control" id="gMapUrl" name="gMapUrl" maxlength="100" value="<%= v('gMapUrl') %>" placeholder="https://maps.app.goo.gl/…" required>
      <small class="form-text text-muted">A Google Maps share link for the venue.</small>
    </div>

    <div class="row">
      <div class="col-sm-6 form-group mb-3">
        <label for="Lat">Latitude</label>
        <input type="text" inputmode="decimal" class="form-control" id="Lat" name="Lat" value="<%= v('Lat') %>" placeholder="53.4">
      </div>
      <div class="col-sm-6 form-group mb-3">
        <label for="Lng">Longitude</label>
        <input type="text" inputmode="decimal" class="form-control" id="Lng" name="Lng" value="<%= v('Lng') %>" placeholder="-2.2">
      </div>
    </div>
    <p class="form-text text-muted small">Coordinates place the pin on the clubs map and the event page map. In Google Maps, right-click the building and click the numbers at the top of the menu to copy them.</p>

    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/admin/venues" class="btn btn-secondary">Cancel</a>
  </form>
</div>

<%- include('../footer.ejs') %>
