<%- include('../header.ejs', { useRosterCss: true }) %>
<%- include('../nav.ejs') %>

<%# useRosterCss: roster.css undoes the global `.starter-template { text-align: center }`
    and the site-wide `.fa` sizing. See CLAUDE.md. %>
<div class="roster-page container-fluid text-left">

  <h1>Registration requests</h1>

  <p class="text-muted">
    Forward a registration email to <strong><%= address %></strong> and it appears here,
    with the names it contains already read out and matched against the players on file.
  </p>

  <% if (!configured) { %>
    <div class="alert alert-warning">
      <strong>Nothing can arrive yet.</strong> <code>REGISTRATION_INBOX_SENDERS</code> is
      unset, so mail to <%= address %> is forwarded to the results inbox as before rather
      than queued. Set it to the addresses you forward from.
    </div>
  <% } %>

  <ul class="nav nav-tabs mb-3">
    <% ['pending', 'done', 'dismissed'].forEach(function (s) { %>
      <li class="nav-item">
        <a class="nav-link <%= s === status ? 'active' : '' %>" href="/admin/player-requests?status=<%= s %>"><%= s[0].toUpperCase() + s.slice(1) %></a>
      </li>
    <% }); %>
  </ul>

  <% if (!requests.length) { %>
    <p class="text-muted">Nothing <%= status %>.</p>
  <% } else { %>
    <table class="table table-sm">
      <thead>
        <tr>
          <th>Received</th>
          <th>From</th>
          <th>Subject</th>
          <th>People</th>
          <% if (status !== 'pending') { %><th>Closed by</th><% } %>
        </tr>
      </thead>
      <tbody>
        <% requests.forEach(function (r) { %>
          <tr>
            <td class="text-nowrap"><%= new Date(r.receivedAt).toLocaleString('en-GB', { timeZone: 'Europe/London', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></td>
            <td><%= r.originalFrom || r.forwardedBy %></td>
            <td><a href="/admin/player-requests/<%= r.id %>"><%= r.subject || '(no subject)' %></a></td>
            <td>
              <% if (!r.total) { %>
                <span class="text-muted">none found &mdash; open to add</span>
              <% } else { %>
                <%= r.handled %> of <%= r.total %> done
              <% } %>
            </td>
            <% if (status !== 'pending') { %><td><%= r.closedBy %></td><% } %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

</div>

<%- include('../footer.ejs') %>
