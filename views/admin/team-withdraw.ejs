<%- include('../header.ejs') %>
<%- include('../nav.ejs') %>

<%
  var t = impact.team;
  var alreadyWithdrawn = !!t.withdrawn;
%>

<div class="col-12">
  <h1>Withdraw <%= t.name %></h1>
  <p><a href="/admin/teams">&laquo; Back to Team Admin</a></p>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <% if (alreadyWithdrawn) { %>
    <div class="alert alert-warning">
      <strong><%= t.name %> is already withdrawn</strong>
      (<%= new Date(t.withdrawn).toISOString().slice(0, 10) %><% if (t.withdrawnReason) { %> &mdash; <%= t.withdrawnReason %><% } %>).
      Withdrawing runs once; use <strong>Reinstate</strong> on
      <a href="/admin/teams">Team Admin</a> to undo it.
    </div>
  <% } else { %>

    <table class="table table-bordered table-sm" style="max-width:40em">
      <tbody>
        <tr><th>Club</th><td><%= t.clubName || '—' %></td></tr>
        <tr><th>Division</th><td><%= t.divisionName || '— none —' %></td></tr>
        <tr><th>Season</th><td><%= impact.season %></td></tr>
        <tr><th>Registered players</th><td><%= impact.players %></td></tr>
        <tr><th>Results already recorded this season</th><td><%= impact.recordedFixtures %></td></tr>
        <tr class="table-warning"><th>Fixtures still to play this season</th><td><%= impact.outstandingFixtures %></td></tr>
      </tbody>
    </table>

    <h3>What this will do</h3>
    <ul>
      <li>
        <strong>The <%= impact.outstandingFixtures %> fixture<%= impact.outstandingFixtures === 1 ? '' : 's' %>
        still to play will be marked <code>void</code></strong> &mdash; not conceded and not
        deleted. Nothing is awarded to anybody. Each of those opponents ends the season
        having played one match fewer, keeping only the points they actually won on court.
        Because those fixtures are not spread evenly across the division, this
        <em>can</em> change where other teams finish; it does so without inventing a
        single result.
      </li>
      <li>
        <strong>The <%= impact.recordedFixtures %> result<%= impact.recordedFixtures === 1 ? '' : 's' %>
        already recorded stay exactly as they are.</strong> Teams that have already played
        <%= t.name %> keep those points. Nothing rewrites a completed scorecard.
      </li>
      <li>
        <strong><%= t.name %> leaves <%= t.divisionName || 'its division' %>,</strong> so it
        stops appearing in the league table and stops being counted on the annual invoice.
        The team row itself is <em>not</em> deleted &mdash; deleting it would add to the 2,132
        fixtures already pointing at team ids that no longer exist. Its history, results and
        player statistics are untouched, and it still appears in the archived tables for
        every season it played.
      </li>
      <li>
        <strong>This is reversible.</strong> Reinstate puts <%= t.name %> back in
        <%= t.divisionName || 'its division' %> and un-voids exactly the fixtures this
        withdrawal voided.
      </li>
    </ul>

    <form method="post" action="/admin/teams/<%= t.id %>/withdraw">
      <div class="form-group" style="max-width:40em">
        <label for="reason">Reason (optional, recorded against the team)</label>
        <input type="text" class="form-control" id="reason" name="reason"
               maxlength="200" placeholder="e.g. folded mid-season, no players available">
      </div>

      <% if (impact.players > 0) { %>
        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" id="releasePlayers"
                 name="releasePlayers" value="yes">
          <label class="form-check-label" for="releasePlayers">
            Also release the <%= impact.players %> registered player<%= impact.players === 1 ? '' : 's' %>
            to No Club / No Team.
            <small class="form-text text-danger">
              <strong>This part cannot be undone.</strong> Reinstating the team will not put
              them back, because nothing records which team they were in. Leave it unticked
              and move them yourself from
              <a href="/manage-players" target="_blank">Team Management</a> if the club wants
              them in its other teams.
            </small>
          </label>
        </div>
      <% } %>

      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="confirm" name="confirm" value="yes">
        <label class="form-check-label" for="confirm">
          I have read the above and want to withdraw <strong><%= t.name %></strong>.
        </label>
      </div>

      <button type="submit" class="btn btn-danger">Withdraw <%= t.name %></button>
      <a class="btn btn-secondary" href="/admin/teams">Cancel</a>
    </form>
  <% } %>
</div>

<%- include('../footer.ejs') %>
