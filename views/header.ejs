<!doctype html>
<html lang="en">
  <head>
    
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PSC0315491"></script>
    
    <%
    /* Browser Sentry and PostHog run in production only.
     *
     * This used to be ungated: isProd was computed below but only ever used to
     * decide on session replay, so error capture ran everywhere — including
     * localhost and headless test runs — and every event arrived tagged
     * `environment: production` because no environment was set at all. The
     * unresolved list was two issues, both of them ours: 65 events from a
     * Playwright suite on localhost:8199, and 3 from driving a wizard on
     * 127.0.0.1:8080. Real user errors would have been lost among them, and it
     * spends free-tier quota to do it.
     *
     * Same condition instrument.js uses for the server side, so the two agree.
     * Cloud Run sets K_SERVICE. */
    var monitoringEnabled = config.NODE_ENV === 'production' || !!config.K_SERVICE;
    %>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      // Named PostHog events (the scorecard wizard's photo auto-fill, for a start), so
      // a recording or a funnel can be found by what happened in it. Always defined,
      // and a no-op wherever PostHog was not loaded — dev, tests, superadmins — so
      // callers never need to check.
      //
      // `opts.leaving` is for a caller about to navigate away (a filter Apply, a save
      // followed by a reload): it sends the event now rather than in the next batch,
      // which the navigation could otherwise cut off.
      window.sblTrack = function (name, props, opts) {
        if (!(window.posthog && window.posthog.__loaded)) return;
        if (opts && opts.leaving) window.posthog.capture(name, props || {}, { send_instantly: true });
        else window.posthog.capture(name, props || {});
      };
    <% if (monitoringEnabled) { %>
    // Are we actually the ones serving this page? Shared by Sentry and PostHog.
    //
    // The `monitoringEnabled` gate above is decided when the page is RENDERED, which keeps
    // dev and test renders out but cannot keep a *production* render from being saved
    // and reopened elsewhere. A saved page carries this snippet, the DSN, and the
    // `Sentry.setUser` id baked in, and goes on reporting as `environment: production`
    // for as long as the file exists.
    //
    // 14 Sep 2026: a saved copy of `/email-scorecard` — a `secured` page, so whoever
    // saved it was logged in — opened off a Windows network share at
    // `file://server/Data/.../stockport-badminton.co.uk/email-scorecard.html` and
    // reported `ReferenceError: $ is not defined`, because jQuery cannot load over
    // `file://`. Nothing was wrong with the site; the page had not been served by us in
    // days. Two events and one "user" who was a file path.
    //
    // So the runtime check: a real scheme, and a host we recognise. `.run.app` is
    // allowed because Firebase rewrites to Cloud Run and that hostname serves the whole
    // site publicly (CLAUDE.md gotcha 1b). An optional `www.` is allowed so a visitor
    // arriving that way is not silently unmonitored.
    window.sblServedByUs = (function () {
      var expectedHost = '<%= siteOrigin().replace(/^https?:\/\//, "") %>';
      var h = location.hostname;
      var servedByUs =
        (location.protocol === 'https:' || location.protocol === 'http:') &&
        (h === expectedHost || h === 'www.' + expectedHost || /\.run\.app$/.test(h));
      return servedByUs;
    })();

    <% if (config.POSTHOG_KEY) { %>
    // PostHog: web analytics on every page, and session recordings on the
    // results-entry pages only. Running alongside Google Analytics from Oct 2026 to
    // see whether it can replace it.
    //
    // cookieless_mode 'always' stores nothing in the browser — no cookie, no
    // localStorage — so it needs no consent. PostHog counts unique visitors with a
    // server-side hash under a salt that is discarded daily, so a visitor returning on
    // another day counts again, and identify() is not available: the account id goes
    // on each event as a property instead.
    //
    // Not loaded at all for a superadmin, who tests these pages daily.
    //
    // Recorded only on a results-entry page — the point is to watch how captains use
    // the photo auto-fill, which needs the whole session from page load. Inputs are
    // unmasked so scores are visible; recordings therefore carry player names.
    (function () {
      var RECORD_PATHS = [
        /^\/email-scorecard/,
        /^\/populated-scorecard-beta/,
        /^\/messer-scorecard-beta/,
        /^\/populated-messer-scorecard/
      ];
      <%
      // Who is using a page, by what they are allowed to do rather than who they are.
      // `role` is 'admin' (a club's captain/secretary, from player.role) or 'member'
      // (logged in with no role); superadmins never get this far. `club` is only known
      // for an admin, because only the admin claim carries one (app.js login strategy).
      var phClaims = (typeof user !== 'undefined' && user._json) || {};
      var phRole = typeof user === 'undefined' ? null : (phClaims['https://my-app.example.com/role'] || 'member');
      var phClub = phRole === 'admin' ? (phClaims['https://my-app.example.com/club'] || null) : null;
      %>
      var loggedIn = <%= typeof user !== 'undefined' ? 'true' : 'false' %>;
      var isSuperadmin = <%= phRole === 'superadmin' ? 'true' : 'false' %>;
      var record = loggedIn && RECORD_PATHS.some(function (re) { return re.test(location.pathname); });
      if (!window.sblServedByUs || isSuperadmin) return;

      var s = document.createElement('script');
      s.async = true;
      s.crossOrigin = 'anonymous';
      s.src = 'https://eu-assets.i.posthog.com/static/array.js';
      s.onload = function () {
        // A recorded page uses in-memory persistence instead of cookieless mode,
        // because the recorder cannot run cookieless: that mode keeps no session in
        // the browser (PostHog assigns $session_id server-side), and without one
        // the recorder never starts. Not one recording was stored in the two days
        // replay ran with cookieless on every page. 'memory' still stores nothing in
        // the browser, so the no-consent position holds; the cost is that each page
        // load is a new session, so the wizard and its confirmation page are two
        // recordings.
        var storage = record ? { persistence: 'memory' } : { cookieless_mode: 'always' };
        window.posthog.init('<%= config.POSTHOG_KEY %>', Object.assign({
          api_host: 'https://eu.i.posthog.com',
          person_profiles: 'never',
          // Names the element behind each LCP/INP/CLS reading (and splits LCP into its
          // phases), so the web vitals say what was slow, not only how slow. Web vitals
          // capture itself is switched on in the project settings, not here.
          capture_performance: { web_vitals_attribution: true },
          disable_session_recording: !record,
          session_recording: { maskAllInputs: false },
        }, storage));
        window.posthog.register({
          league: location.hostname.replace(/^www\./, ''),
          logged_in: loggedIn,
          account_id: <%- typeof user !== 'undefined' ? JSON.stringify(String(user.user_id)).replace(/</g, '\\u003c') : 'null' %>,
          role: <%- JSON.stringify(phRole).replace(/</g, '\\u003c') %>,
          club: <%- JSON.stringify(phClub).replace(/</g, '\\u003c') %>,
          messer_admin: <%= phClaims['https://my-app.example.com/messeradmin'] === true ? 'true' : 'false' %>
        });
      };
      document.head.appendChild(s);
    })();
    <% } %>
    <% } %>
    </script>


      <% if (typeof user !== 'undefined') { %>
        <script> 
      gtag('config', 'G-PSC0315491',{'cookie_prefix': 'baddersCookie',
  'cookie_domain': 'stockport-badminton.co.uk',
  'cookie_expires': 28 * 24 * 60 * 60 ,  // 28 days, in seconds,
  'user_id': '<%= user.user_id %>' });
    gtag('set', 'user_properties', { 
    'crm_id' : '<%= user.user_id %>' 
    });
    <% if (monitoringEnabled) { %>
    window.sentryOnLoad = function () {
      // in here, Sentry is ensured to be loaded & fully available
      if (!window.sblServedByUs) return;

      // No session replay here any more: PostHog records the scorecard flows (below).
      // Sentry's free tier is 50 replays a month shared with tameside-site, which ran
      // out within days once the stats pages were on the list, and a replay that starts
      // at the error (buffer mode keeps ~60s) misses the OCR steps that come before it.
      // Two recorders on one phone page would also be twice the CPU for one recording.
      Sentry.init({
        dsn: "https://41a5442332daa78ebc9dba9dfe8da392@o4508301910540288.ingest.de.sentry.io/4508301914800208",
        // Label events instead of letting them all default to "production" — this
        // block only loads in production now, but a mislabelled event is worse than
        // an unlabelled one if that ever changes.
        environment: "<%= config.NODE_ENV || 'production' %>",
        tracesSampleRate: 0,
      });


      Sentry.lazyLoadIntegration("captureConsoleIntegration").then(
        (integration) => {
          // Only forward real errors — not console.log/info/debug/warn — so
          // stray dev logging doesn't flood Sentry (and the free-tier quota).
          Sentry.addIntegration(integration({ levels: ['error'] }));
        },
      );
      Sentry.setUser({ id: '<%= user.user_id %>' });
    }
    <% } %>
      </script>
      <% if (monitoringEnabled) { %>
      <%# Not just gated at init: outside production the loader is never fetched
          either, so local pages don't pay for the request. %>
      <%# defer, not blocking: a synchronous script here held up rendering of every page a
          logged-in member opened (HARD-44). sentryOnLoad above is defined first either way. %>
      <script defer src="https://js-de.sentry-cdn.com/41a5442332daa78ebc9dba9dfe8da392.min.js" crossorigin="anonymous"></script>
      <% } %>
      
    <% } else{ %>
      <script> 
        gtag('config', 'G-PSC0315491',{
  'cookie_prefix': 'baddersCookie',
  'cookie_domain': 'stockport-badminton.co.uk',
  'cookie_expires': 28 * 24 * 60 * 60  // 28 days, in seconds
});
</script>
      <% } %> 

<%#
  Structured data (JSON-LD) arrives pre-built as `jsonLd`, an array of serialised
  blocks, from whichever controller rendered the page — see
  utils/structuredData.js.

  It used to be written here as literal JSON in three copies, selected by sniffing
  the page title (indexOf "Event", indexOf "Homepage", equals 'Local Badminton Club
  Information'), and interpolated with escaped-output tags — which escape for HTML,
  not JSON, so an apostrophe in a club name shipped as &#39; and a double quote
  would have broken the block outright. Several of the property names were also not
  schema.org at all, so the most valuable fields (team names, the whole postal
  address, the coordinates) were silently discarded.
%>
<% if (typeof jsonLd !== 'undefined' && Array.isArray(jsonLd)) { %>
  <% jsonLd.forEach(function(block) { %>
    <script type="application/ld+json"><%- block %></script>
  <% }) %>
<% } %>

<%# The event page's map container still needs its height. %>
<% if (pageTitle.indexOf("Event") >= 0){ %>
      <style>
        #eventMap {box-sizing: content-box;
        height: 100%;}
      </style>
<%  }
 %>

 

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%- include('pwa-head.ejs') %>
    <meta name="description" content="Stockport &amp; District Badminton Association. <%= pageDescription %>">
    <meta name="author" content="">
    <meta property="og:title" content="Stockport &amp; District Badminton League - <%= pageTitle %>">
    <meta property="og:description" content="Stockport &amp; District Badminton Association. <%= pageDescription %>">
    <meta property="og:image" content="<%= static_path %>/beta/images/SDBLLogo.png">
    <meta property="og:url" content="<%= canonical %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta property="og:site_name" content="Stockport &amp; District Badminton League">
    <meta name="twitter:image:alt" content="Stockport &amp; District Badminton League">

    <title>Stockport &amp; District Badminton League - <%= pageTitle %></title>

    <%- include('touch-icons.ejs') -%>

    <%# The background on <main class="respBgImg"> is the LCP element on most pages, and its
        URL is in custom.css, so without this the browser cannot start it until that file has
        arrived. One link per breakpoint; each media range matches exactly one, so only the
        image the CSS will use is fetched. See utils/backgroundPreload.js. %>
    <% backgroundPreloads().forEach(function(bg) { %>
    <link rel="preload" as="image" fetchpriority="high" href="<%= bg.href %>" media="<%= bg.media %>">
    <% }) %>
    <!-- Bootstrap core CSS (self-hosted from node_modules so it works offline) -->
    <link rel="stylesheet" href="<%= asset('/scripts/bootstrap/dist/css/bootstrap.min.css') %>">
    <%# No Font Awesome stylesheet: icons are inline SVG from utils/icons.js (HARD-44). %>
    <%# DataTables CSS is only needed on the six views that build a table, so those
        views opt in with include('header.ejs', { useDataTables: true }). It used to
        load unconditionally on every page. %>
    <% if (typeof useDataTables !== 'undefined' && useDataTables) { %>
      <%- include('datatables-css.ejs') -%>
    <% } %>

    <link rel="stylesheet" type="text/css" href="<%= asset('/static/beta/css/custom.css') %>"/>
    <%# Team-management styles, opted into the same way as DataTables above so they
        don't load on the other 40-odd pages. Used by roster.ejs and roster-edit.ejs. %>
    <% if (typeof useRosterCss !== 'undefined' && useRosterCss) { %>
      <link rel="stylesheet" type="text/css" href="<%= asset('/static/beta/css/roster.css') %>"/>
    <% } %>
    <% if (typeof useLiveScorecardCss !== 'undefined' && useLiveScorecardCss) { %>
      <link rel="stylesheet" type="text/css" href="<%= asset('/static/beta/css/live-scorecard.css') %>"/>
    <% } %>
    <%# Pages whose URL carries a secret (the live scorecard's token) must never be indexed. %>
    <% if (typeof noindex !== 'undefined' && noindex) { %>
      <meta name="robots" content="noindex, nofollow">
    <% } %>
    <% if (typeof canonical != 'undefined') { %>
      <link rel="canonical"
            href="<%= canonical %>" />
    <% } %>

    

      
  </head>
  <body>
