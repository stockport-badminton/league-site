<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#673ab6">
<%# A page can opt out with `serviceWorker: false`; the 404 page does. A headless crawler opens
    every page in a fresh browser, so each dead link it followed installed the worker and
    precached the pages below again: ~7,000 of the 16,700 requests in the Nov 2026 crawl.
    Nobody needs the site offline from a 404; the next real page registers it. %>
<% if (locals.serviceWorker !== false) { %>
<script defer src="<%= asset('/static/beta/js/sw-register.js') %>"></script>
<% } %>
<script defer src="<%= asset('/static/beta/js/offline-banner.js') %>"></script>
