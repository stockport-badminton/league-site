<%- include('header.ejs', { useDataTables: true }) %>
<%- include('nav.ejs') %>


  <% if (error) { %>
    <p>Something seems to have gone wrong</p>
    <p><%= error %></p>
  <% }
  else { %>
    
    <div class="row col-12">
      <h1><%= division %></h1>
      <a class="text-secondary other-tooltip" href="<%= path.replace('\/results\/','\/results-grid\/') %>" data-text="Grid view"><i class="fa fa-th"></i></a><br />
      <a class="text-secondary other-tooltip" href="<%= path.replace('\/results\/','\/calendars\/') %>" data-text="download the calendar or copy the link"><i class="fa fa-calendar"></i></a>
      <a id="showFilter" class="text-secondary other-tooltip" href="" data-text="show/hide filters"><i class="fa fa-filter"></i></a>
    </div>
    <% if (typeof admin !== 'undefined') { %>
    <div class="row col-12">
        <p>Welcome!<br />
          <%= user.nickname %><br />
          Club:<%= user._json["https://my-app.example.com/club"] %><br />
          Role:<%= user._json["https://my-app.example.com/role"] %>
        </p>  
    </div>
      
    <% } %>
    <% if (typeof filter !== 'undefined' && filter == true){ %>
      <%- include('filters.ejs') %>
    <% } %>
    <div class="dt-table-shell">
    <table class="table" id="results-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Home Team</th>
          <th>Away Team</th>
          <th>Result</th>
          <% if (typeof admin !== 'undefined') { %>
            <th>Details</th>
          <% } %>
          <% if (typeof superadmin !== 'undefined' && superadmin) { %>
            <th>Rearrange?</th>
            <th>Confirm/Enter</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
    <% var tournamentReminder = false %>
    <% var tournament2Reminder = false %>
    <% result.forEach(function(row){ %>
      <%
        var rowClass = '';
        var resultValue = '';
        var status = ""
        var MyDate = new Date(row['date']);
        var NowDate = Date.now();
        if ((MyDate < NowDate) && (row['homeScore'] == null) && (row['status'] != 'void')) {
          rowClass = 'table-danger'
          var resultValue = 'Awaiting Result';
        }
        var MyDateString;

        // MyDate.setDate(MyDate.getDate() + 20);

        MyDateString = ('0' + MyDate.getDate()).slice(-2) + '/'
                     + ('0' + (MyDate.getMonth()+1)).slice(-2) + '/'
                     + MyDate.getFullYear();

        var isoDate = MyDate.getFullYear() + '-'
                    + ('0' + (MyDate.getMonth()+1)).slice(-2) + '-'
                    + ('0' + MyDate.getDate()).slice(-2);
      %>

      <% if (row['status'] == 'rearranging'){
        var rowClass = 'table-warning';
        var resultValue = 'Rearranging';
        var status = ""
       }
       %>

       <% if (row['homeTeam'].indexOf('Tournament') > -1 || row['homeTeam'].indexOf('Messer') > -1 ){
         var rowClass = 'table-danger';
         var status = ""
        }
        %>
       <% if (row['status'] == 'rearranged'){
        var rowClass = 'table-warning';
        var resultValue = 'Rearranged';
        var status = ""
       }
       %>

       <% if (row['status'] == 'conceded'){
        var rowClass = 'table-danger';
        var resultValue = 'Conceded';
        var status = "Conceded"
       }
       %>

       <% if (row['status'] == 'void'){
         var rowClass = 'table-danger';
         var resultValue = "Void"
         var status = "Void"
        }
        %>

      <tr class="<%= rowClass %>">

          <% if (typeof superadmin !== 'undefined' && superadmin) { %>
          <td class="fixture-date" data-fixture-id="<%= row['id'] %>" data-iso="<%= isoDate %>">
            <span class="fd-text"><%= MyDateString %></span>
            <a href="#" class="fd-edit" title="Edit date" aria-label="Edit date"><i class="fa fa-pencil"></i></a>
          </td>
          <% } else { %>
          <td><%= MyDateString %></td>
          <% } %>
          <td data-homeTeam="<%= row['homeClubId'] %>"><a href="<%= row['venueLink'] %>" target="_blank"><i class="fa-solid fa-map-location-dot"></i></a><%= row['homeTeam'] %></td>
          <td data-awayTeam="<%= row['awayTeamId'] %>"><%= row['awayTeam'] %></td>
          <% if(row['homeScore'] != null){
               // Through the shared helper so this cannot drift from the URL the
               // Make.com webhook sends, and so the segments are encoded: team and
               // division names contain spaces, and the raw value here goes into
               // data-img-url, which the share button hands to the Web Share API.
               var resultImgUrl = resultImagePath({
                 homeTeam: row['homeTeam'], awayTeam: row['awayTeam'],
                 homeScore: row['homeScore'], awayScore: row['awayScore'],
                 division: row['divisionName']
               });
             %>
          <td><%= row['homeScore'] %>-<%= row['awayScore'] %> <%= status %>
            <% if (typeof superadmin !== 'undefined' && superadmin) { %><br /><a href="<%= resultImgUrl %>">Social Image</a><% } %>
            <br /><a href="#" class="share-result-btn" data-img-url="<%= resultImgUrl %>" data-title="<%= row['homeTeam'] %> vs <%= row['awayTeam'] %>">Share</a>
          </td>
            <% if (typeof admin !== 'undefined') { %>
            <td><a href="/scorecard/fixture/<%= row['id'] %>">Details</a></td>
            <% } %>
          <% }
          else { %>
           <td><%= resultValue %></td>
           <% if (typeof admin !== 'undefined') { %>
            <td></td>
            <% } %>
          <% } %>
          <% if (typeof superadmin !== 'undefined' && superadmin) { %>

            <td><% if (row['status'] === 'outstanding' || row['status'] === 'rearranged' || row['status'] === 'rearranging') { %>
                  <a data-toggle="modal" data-target="#exampleModal" data-club="<%= row['name'] %>" data-fixtureId="<%= row['id'] %>">Rearrange</a> 
                  <%# Only in the 48 hours before the card is due (fixture + 5 days) and only
                      while no draft is filed — row.reminderDue, utils/scorecardReminder.js. %>
                  <% if(row['reminderDue']){ %>
                  <br /><a href="#" data-toggle="modal" data-target="#reminderModal" data-fixture-id="<%= row['id'] %>" data-home-team="<%= row['homeTeam'] %>" data-away-team="<%= row['awayTeam'] %>">Send Reminder</a>
                <% } } %>
            </td>
            
            <%# `row['homeClubName']` is undefined — getFixtureDetails returns `homeClub`,
                and this comparison has therefore always been false, so the Enter and
                Confirm links below have only ever shown to a user whose club is 'All'.
                NOT fixed to `homeClub`, deliberately: /fixtures/edit/:id does not exist.
                It is swallowed by the `/fixtures/*` wildcard, which ignores the id — both
                /fixtures/edit/7313 and /fixtures/edit/1 return the same page. Making the
                comparison work would show every captain two links to nowhere. The fix is
                to point them at /scorecard-beta and /populated-scorecard-beta/:id, or to
                delete them; either is a decision about what captains should be offered. %>
            <% if (user._json["https://my-app.example.com/club"] == 'All' || user._json["https://my-app.example.com/club"] == row['homeClubName']){ %>
              <td><a href="/fixtures/edit/<%= row['id'] %>">Enter</a></td> 
            <% } 
            else { %>
              <td><a href="/fixtures/edit/<%= row['id'] %>">Confirm</a></td> 
            <% } %>
          <% } %>
      </tr>
    <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
   <% } %>

   <% if (typeof superadmin !== 'undefined' && superadmin) { %>
   
   <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="exampleModalLabel">Rearrangement</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <form role="form" id="contactUs" action="/fixture/rearrangement" method="post">
        <div class="modal-body" id="rearrangementModal">
          <div class="formMessage" style="display:none">Fixture Updated!</div>
            <div id="rearrangementForm" class="form-group">
              <label for="contactEmail">New Fixture Date</label>
              <input type="date" class="form-control" id="date" name="date" placeholder="DD/MM/YYYY">
              <small id="emailHelp" class="form-text text-muted">Leave this blank if you haven't fixed a date yet.</small>
              <input type="hidden" name="fixtureId" id="fixtureId" value="" />
              <input type="hidden" name="homeTeam" id="homeTeam" value="" />
              <input type="hidden" name="awayTeam" id="awayTeam" value="" />
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          <button type="button" id="fixtureRearange" class="btn btn-primary">Submit</button>
        </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="reminderModal" tabindex="-1" role="dialog" aria-labelledby="reminderModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="reminderModalLabel">Send scorecard reminder</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <form role="form" id="reminderForm" action="/fixture/reminder" method="post">
        <div class="modal-body" id="reminderModalBody">
            <%# The form and the outcome message are separate elements, shown and hidden,
                so every open can reset both. The old handler replaced the body's HTML
                with "Reminder sent!" and removed the Submit button, so after one send
                every other fixture's popup opened on that message. %>
            <div id="reminderFields" class="form-group">
              <p id="reminderFixture" class="mb-2 font-weight-bold"></p>
              <label for="reminderRecipients">Send to</label>
              <input type="text" class="form-control" id="reminderRecipients" name="recipients" autocomplete="off" />
              <small class="form-text text-muted">Comma-separated. Pre-filled with the home club's secretary, match secretary and team captain.</small>
              <ul id="reminderContacts" class="small text-muted mt-2 mb-0 pl-3"></ul>
              <input type="hidden" name="fixtureId" id="reminderFixtureId" value="" />
            </div>
            <div id="reminderMessage" class="alert mb-0" role="status" style="display:none"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          <button type="button" id="remindFixture" class="btn btn-primary">Send</button>
        </div>
        </form>
      </div>
    </div>
  </div>

  <% } %>


<%- include('footer.ejs') %>
<%- include('datatables.ejs') %>
<script type="text/javascript">
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.share-result-btn');
    if (!btn) { return; }
    e.preventDefault();

    var imgUrl = btn.getAttribute('data-img-url');
    var title = btn.getAttribute('data-title');

    if (!navigator.share) {
      window.open(imgUrl, '_blank');
      return;
    }

    fetch(imgUrl)
      .then(function(resp) { return resp.blob(); })
      .then(function(blob) {
        var file = new File([blob], 'result.jpg', { type: 'image/jpeg' });
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          return navigator.share({ files: [file], title: title, text: title });
        }
        return navigator.share({ title: title, text: title, url: location.origin + imgUrl });
      })
      .catch(function(err) {
        if (err.name !== 'AbortError') { console.warn('Share failed:', err); }
      });
  });
</script>
<% if (typeof filter !== 'undefined' && filter == true){ %>
<script type="text/javascript">
      <%- include('filtersJs.ejs') %>
</script>
<% } %>

<% if (typeof superadmin !== 'undefined' && superadmin) { %>
  <script type="text/javascript">

    
      $('a[data-target="#exampleModal"]').click(function(){
        $('#rearrangementModal > .formMessage').hide();
        $('#rearrangementForm > #date').show()
        $('#rearrangementForm > label').show()
        $('#fixtureRearange').show();
        $('#emailHelp').show()
        $('#rearrangementForm > #date')[0].value = "";
        $('#fixtureId')[0].value = $(this)[0]['attributes']['data-fixtureId'].value;
        $('#homeTeam')[0].value = $(this).parent().siblings()[1].textContent;
        $('#awayTeam')[0].value = $(this).parent().siblings()[2].textContent;
      })

      // Each open resets the popup completely — fields back, message gone, Send
      // enabled — and ignores a contacts answer that arrives after a different fixture
      // has been opened.
      var reminderRequest = 0;
      $('a[data-target="#reminderModal"]').click(function(e){
        e.preventDefault();
        var link = $(this);
        var requestId = ++reminderRequest;
        $('#reminderFixtureId').val(link.attr('data-fixture-id'));
        $('#reminderFixture').text(link.attr('data-home-team') + ' v ' + link.attr('data-away-team'));
        $('#reminderRecipients').val('').prop('disabled', true).attr('placeholder', 'Looking up contacts…');
        $('#reminderContacts').empty();
        $('#reminderMessage').hide().removeClass('alert-success alert-danger alert-warning').text('');
        $('#reminderFields').show();
        $('#remindFixture').show().prop('disabled', true);

        $.getJSON('/fixture/' + encodeURIComponent(link.attr('data-fixture-id')) + '/reminder-contacts')
          .done(function (data) {
            if (requestId !== reminderRequest) return;
            var addresses = [];
            (data.contacts || []).forEach(function (c) {
              var item = $('<li>').text(c.role + ': ' + c.name + (c.email ? ' — ' + c.email : ' — no email on file'));
              $('#reminderContacts').append(item);
              if (c.email && addresses.indexOf(c.email) === -1) addresses.push(c.email);
            });
            if (!(data.contacts || []).length) {
              $('#reminderContacts').append($('<li>').text('Nobody is flagged as secretary, match secretary or captain for the home team.'));
            }
            $('#reminderRecipients').val(addresses.join(', '));
          })
          .fail(function () {
            if (requestId !== reminderRequest) return;
            $('#reminderMessage').addClass('alert-warning')
              .text('Could not look up the contacts — type the addresses in yourself.').show();
          })
          .always(function () {
            if (requestId !== reminderRequest) return;
            $('#reminderRecipients').prop('disabled', false).attr('placeholder', 'name@example.com, …');
            $('#remindFixture').prop('disabled', false);
          });
      })

     /*  $('#fixtureRearange').click(function(){
        $.post('/fixture/rearrangement', {'date':$('#date')[0].value,'homeTeam':$('#homeTeam')[0].value,'awayTeam':$('#awayTeam')[0].value }, function (data) {
               console.log({'date':$('#date')[0].value,'homeTeam':$('#homeTeam')[0].value,'awayTeam':$('#awayTeam')[0].value });
               console.log(data);
               $('#rearrangementModal').html('<p>Fixture Updated!</p>');
               $('#fixtureRearange').remove();
            });
      }) */

      $('#fixtureRearange').click(function(){
        // The endpoint now answers JSON and can legitimately say no — an unmatched
        // team name or a pairing with no fixture this season. Reporting only success
        // meant a rejected request looked exactly like an accepted one.
        $.post('/fixture/rearrangement', {'date':$('#date')[0].value,'homeTeam':$('#homeTeam')[0].value,'awayTeam':$('#awayTeam')[0].value })
          .done(function (data) {
            var msg = data && data.action === 'rearranging'
              ? 'Fixture flagged as rearranging — no new date set.'
              : 'Fixture Updated!';
            $('#rearrangementModal > .formMessage').text(msg).show();
            $('#rearrangementForm > label').hide()
            $('#rearrangementForm > #date').hide()
            $('#emailHelp').hide()
            $('#fixtureRearange').hide();
          })
          .fail(function (xhr) {
            var err = (xhr.responseJSON && xhr.responseJSON.error) || 'Something went wrong — the fixture was not changed.';
            $('#rearrangementModal > .formMessage').text(err).show();
          });
      })

      $('#remindFixture').click(function(){
        var button = $(this).prop('disabled', true);
        $.post('/fixture/reminder', {
          fixtureId: $('#reminderFixtureId').val(),
          recipients: $('#reminderRecipients').val()
        })
          .done(function () {
            $('#reminderFields').hide();
            button.hide();
            $('#reminderMessage').removeClass('alert-danger alert-warning').addClass('alert-success')
              .text('Reminder sent to ' + $('#reminderRecipients').val() + '.').show();
          })
          .fail(function (xhr) {
            // Say why, and leave the form up so the address can be corrected.
            var err = (xhr.responseJSON && xhr.responseJSON.error) || 'Something went wrong — no reminder was sent.';
            $('#reminderMessage').removeClass('alert-success alert-warning').addClass('alert-danger').text(err).show();
            button.prop('disabled', false);
          });
      })

      // Inline fixture date edit (superadmin): edits the existing date in place.
      $('#results-table').on('click', '.fd-edit', function(e){
        e.preventDefault();
        var $cell = $(this).closest('.fixture-date');
        if ($cell.find('input.fd-input').length) return; // already editing
        $cell.data('prev', $cell.html());
        $cell.html(
          '<input type="date" class="fd-input" value="' + $cell.attr('data-iso') + '" style="width:150px;"> '
          + '<a href="#" class="fd-save" title="Save">✓</a> '
          + '<a href="#" class="fd-cancel" title="Cancel">✕</a> '
          + '<div class="fd-msg" style="color:#a5342b;font-size:12px;"></div>'
        );
        $cell.find('input.fd-input').focus();
      });
      $('#results-table').on('click', '.fd-cancel', function(e){
        e.preventDefault();
        var $cell = $(this).closest('.fixture-date');
        $cell.html($cell.data('prev'));
      });
      $('#results-table').on('click', '.fd-save', function(e){
        e.preventDefault();
        var $cell = $(this).closest('.fixture-date');
        var id = $cell.attr('data-fixture-id');
        var val = $cell.find('input.fd-input').val();
        if (!/^\d{4}-\d{2}-\d{2}$/.test(val)) { $cell.find('.fd-msg').text('Pick a valid date'); return; }
        $cell.find('.fd-save, .fd-cancel').hide();
        $.ajax({ url: '/admin/fixture/' + id + '/date', method: 'POST', data: { date: val } })
          .done(function(){
            var p = val.split('-');
            $cell.attr('data-iso', val);
            $cell.html('<span class="fd-text">' + p[2] + '/' + p[1] + '/' + p[0] + '</span> '
              + '<a href="#" class="fd-edit" title="Edit date" aria-label="Edit date"><i class="fa fa-pencil"></i></a>');
          })
          .fail(function(xhr){
            $cell.find('.fd-msg').text((xhr.responseJSON && xhr.responseJSON.error) || 'Save failed');
            $cell.find('.fd-save, .fd-cancel').show();
          });
      });
      $('#results-table').on('keydown', 'input.fd-input', function(e){
        if (e.key === 'Enter') { e.preventDefault(); $(this).closest('.fixture-date').find('.fd-save').click(); }
        else if (e.key === 'Escape') { $(this).closest('.fixture-date').find('.fd-cancel').click(); }
      });
  </script>
<% } %>

</body>
</html>
