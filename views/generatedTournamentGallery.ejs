<div class="modal" id="generatedTournamentGalleryModal">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title">Messer Competition Gallery</h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <div id="carouselExampleControls" class="carousel slide" data-ride="carousel">
          <div class="carousel-inner">
            <%  
                var i = 0 
                var active = "active"
                assets.forEach(function(image){ 
                  if (i > 0){
                    active = ""
                  }
                  i++
                  var imageref = image.url.replace("/upload","/upload/f_auto,c_fill/w_auto:breakpoints_200_1920_30_10:300")
                  if (typeof image.context != 'undefined'){
                    var caption = (image.context.custom.caption.length > 0 ? image.context.custom.caption : "")
                  }
                  
              %>
              <div class="carousel-item <%= active %>">
                    <img class="d-block img-fluid" data-src="<%= imageref %>" sizes="100vw" width="100%" border=0 alt="" title=""/>
                <div class="carousel-caption d-none d-md-block">
                  <h5><%= caption %></h5>
                </div>
              </div>
            <% }) %>
          </div>
          <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
          </a>
          <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
          </a>
        </div>
      </div>

      <!-- Modal footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
      </div>

    </div>
  </div>
</div>
<script>
  // The gallery's images are fetched when the modal opens, not with the page (HARD-43).
  // A hidden modal does not stop an <img src> downloading: this was ~10 requests and
  // ~425 KB on every homepage view, for a gallery most visitors never open. Bound on
  // DOMContentLoaded because jQuery and Bootstrap load in the footer, after this.
  document.addEventListener('DOMContentLoaded', function () {
    $('#generatedTournamentGalleryModal').one('show.bs.modal', function () {
      this.querySelectorAll('img[data-src]').forEach(function (img) {
        img.src = img.getAttribute('data-src');
        img.removeAttribute('data-src');
      });
    });
  });
</script>
