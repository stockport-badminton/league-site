<%#
  The "how to turn on notifications" walkthrough, in a native <dialog>. Any element with
  [data-notifications-video] opens it. Phone cut only: it's a phone task, and a portrait video
  plays fine in the dialog on a desktop. Recorded from the local database with fictional teams;
  see tools/demo-video/README.md before re-recording it.
%>
<dialog id="notificationsVideo" class="p-0 border-0 rounded shadow" aria-label="How to turn on notifications">
  <form method="dialog" class="text-right text-end m-0"><button class="btn btn-sm btn-light m-1" aria-label="Close">&times;</button></form>
  <video id="notificationsVideoPlayer" controls playsinline preload="none"
         poster="<%= asset('/static/beta/video/notifications-mobile.jpg') %>"
         src="<%= asset('/static/beta/video/notifications-mobile.mp4') %>"></video>
  <p class="small text-center my-2"><a href="/notifications">Turn on notifications &rarr;</a></p>
</dialog>
<style>
  #notificationsVideo { max-width: 96vw; max-height: 96vh; background: #111; }
  #notificationsVideo::backdrop { background: rgba(0, 0, 0, .7); }
  #notificationsVideo video { display: block; max-width: 92vw; max-height: 80vh; }
  #notificationsVideo .small a { color: #ddd; }
</style>
<script src="<%= asset('/static/beta/js/notifications-video.js') %>"></script>
