<%- include('header.ejs') %>
<%- include('nav.ejs') %>


  <% if (error) { %>
    <p>Something seems to have gone wrong</p>
    <p><%= error %></p>
  <% }
  else { %>
    <div id="map" data-maps-key="<%= mapsApiKey %>"></div>
    <img id="map-fallback" src="/static/generated/venues-map.png" alt="Map of club venues" style="display:none; width:100%;">

    <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Contact</th>
          <% if (typeof user !== 'undefined' && user['_json']['https://my-app.example.com/role'] == "superadmin") { %>
            <th>Manage Players</th>
          <% } %>
          <th>Match Details</th>
          <th>Club Night</th>
          <th>Venue</th>
        </tr>
      </thead>
      <tbody>
    <% result.forEach(function(row){ 
      if (row['clubId'] != 63) { %>

      

        <%# Kept as a deep-link target for this table. It was briefly what the club's
            SportsClub `url` pointed at, before the clubs got pages of their own. %>
        <tr id="club-<%= row['id'] %>">
          <%# The club name links to the club's own page on this site, and the
              external website gets its own link beside it.

              It used to link straight out to the club's website, which meant the
              per-club pages had no inbound link at all — and a page nothing links to
              is one a crawler has little reason to rank, sitemap entry or not. The
              outbound link is kept because for most visitors the club's own site is
              still the better destination. %>
            <td>
              <a href="<%= clubPath(row) %>"><%= row['name'] %></a>
              <% if (row['clubWebsite']) { %>
                <br /><small><a href="<%= row['clubWebsite'] %>" target="_blank" rel="noopener">club website</a></small>
              <% } %>
            </td>
            <td>
              <% if(locals.user) { %>
                <a href="/club/<%= row['id'] %>">Club Contact Details</a><br />
                <button type="button" class="btn btn-primary openForm" data-toggle="modal" data-target="#exampleModal" data-club="<%= row['id'] %>">
                  Get in touch
                </button>
              <% } 
              else { %>
                <button type="button" class="btn btn-primary openForm" data-toggle="modal" data-target="#exampleModal" data-club="<%= row['id'] %>">
                  Get in touch
                </button>
              <% }
              %>
            </td>
            <% if (typeof user !== 'undefined' && user['_json']['https://my-app.example.com/role'] == "superadmin") { %>
              <td><a href="/manage-players/club-<%= row['name'] %>">Manage Players</a></th>
            <% } %>
            <td><% if (row.teams.length > 1){ 
               for (team of row.teams){ %>
                <%= team.name %>: <a href="<%= team.gMapUrl %>" target="_blank"><%= team.address %></a><br />
                <%= team.matchDay %><br />
              <% }
              %>
              
            <% } else { %>
              All Teams: <a href="<%= row.teams[0].gMapUrl %>" target="_blank"><%= row.teams[0].address %></a><br />
              <%= row.teams[0].matchDay %><br />
            <% } %>
              </td>
            <td><%= clubNightText(row['clubNightText']) %></td>
            <td><a href="<%= row['gMapUrl'] %>" target="_blank"><%= row['address'] %></a></td>
        </tr>
    <% 
     }
      }) %>
      </tbody>
    </table>
    </div>
   <% } %>

   <!-- Modal -->
   <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
     <div class="modal-dialog" role="document">
       <div class="modal-content">
         <div class="modal-header">
           <h5 class="modal-title" id="exampleModalLabel">Get in touch with </h5>
           <button type="button" class="close" data-dismiss="modal" aria-label="Close">
             <span aria-hidden="true">&times;</span>
           </button>
         </div>
         <form role="form" id="contactUs" action="/contact-us" method="post">
         <div class="modal-body">
            <input type="hidden" value="" id="clubSelect" name="clubSelect" />
            <input type="hidden" value="Clubs" id="contactType" name="contactType" />

             <div class="form-group">
               <label for="contactEmail">Email address</label>
               <input type="email" class="form-control" id="contactEmail" name="contactEmail" aria-describedby="emailHelp" placeholder="Enter email">
               <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
             </div>
             <div class="form-group">
               <label for="contactQuery">Message that you want to send to the club contact</label>
               <textarea class="form-control" id="contactQuery" name="contactQuery" rows="3"></textarea>
             </div>
             <%- include('spam-fields.ejs') %>

             <div class="form-group">
               <div class="g-recaptcha" data-sitekey="<%= recaptcha %>"></div>
             </div>


         </div>
         <div class="modal-footer">
           <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
           <button type="submit" class="btn btn-primary">Submit</button>
         </div>
         </form>
       </div>
     </div>
   </div>

<%- include('footer.ejs') %>




<!-- The popup builder is a file, not an inline block, so it can be unit-tested.
     See static/beta/js/venue-popup.js and __tests__/unit/venue-popup.test.js. -->
<script type="application/json" id="venue-data"><%- jsonForScript(venues) %></script>
<script src="<%= asset('/static/beta/js/venue-popup.js') %>"></script>
<script src="<%= asset('/static/beta/js/venue-map.js') %>"></script>

<script src="//www.google.com/recaptcha/api.js" async defer></script>



<script src="<%= asset('/static/beta/js/club-contact.js') %>"></script>



</body>
</html>
