<%- include('header.ejs', { useRosterCss: true }) %>
<%- include('nav.ejs') %>

<%# Superadmin entry point to team management. The nav used to link directly to
    /manage-players/club-Aerospace — the alphabetically first club, standing in for
    a picker. %>

<div class="roster-page">
  <div class="roster-head">
    <div>
      <h1>Team Management</h1>
      <div class="roster-sub">Registrations by club</div>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-sm">
      <thead>
        <tr>
          <th>Club</th>
          <th class="text-right">Teams</th>
          <th class="text-right">Players</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% clubs.forEach(function(club) { %>
          <tr<%= club.teams === 0 ? ' class="text-muted"' : '' %>>
            <td>
              <a href="/manage-players/club-<%= encodeURIComponent(club.name) %>"><%= club.name %></a>
            </td>
            <td class="text-right"><%= club.teams %></td>
            <td class="text-right"><%= club.players %></td>
            <td class="text-right text-nowrap">
              <% if (club.teams > 0) { %>
                <a class="btn btn-sm btn-outline-primary py-0"
                   href="/manage-players/club-<%= encodeURIComponent(club.name) %>/edit">Manage</a>
              <% } else { %>
                <span class="small">No teams</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('footer.ejs') %>
</body>
</html>
