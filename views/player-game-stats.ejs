<%- include('header.ejs', { useDataTables: true }) %>
<%- include('nav.ejs') %>


<div class="col-12">

  <% if (typeof errors !== 'undefined') { %>
    <p>Something seems to have gone wrong</p>
    <p><%= error %></p>
  <% }
  else { %>
    <h1><%= fullName %></h1>
    <% if (typeof strength !== 'undefined' && strength && strength.latest) { %>
    <p class="text-muted small" id="points-rating">Points rating (admin only): <strong><%= strength.latest.rating %></strong>
      ±<%= strength.latest.se %>, week of <%= strength.latest.asOf %>. Dashed on the chart, shaded ± its uncertainty; compare only within a gender.</p>
    <% } %>

    <% if (result && result.length > 0) { %>
    <div class="card mb-4">
      <div class="card-body p-2" style="position:relative;height:400px;">
        <canvas id="elo-chart"></canvas>
      </div>
    </div>
    <% } %>

    <div class="dt-table-shell">
    <table class="table" id="results-table">
      <thead>
        <tr>
          <th>date</th>
          <th>team</th>
          <th>Partner</th>
          <th>Opponent 1</th>
          <th>Opponent 2</th>
          <th>points for</th>
          <th>points against</th>
          <th>type</th>
          <th>rating before</th>
          <th>rating after</th>
          <th>adjustment</th>
        </tr>
      </thead>
      <tbody>
    <% result.forEach(function(row){ %>
      <%
        var MyDate = new Date(row['date']);
        var MyDateString;

        // MyDate.setDate(MyDate.getDate() + 20);

        MyDateString = ('0' + MyDate.getDate()).slice(-2) + '/'
                     + ('0' + (MyDate.getMonth()+1)).slice(-2) + '/'
                     + MyDate.getFullYear();
      %>

      <tr>

          <td><%= MyDateString %></td>
          <td><%= row['teamName'] %> <% if(row['teamAdjustment'] > 0) { %>(+<%= row['teamAdjustment'] %>)<% } %></td>
          <td><%= row['partnerName'] %></td>
          <td><%= row['oppName1'] %></td>
          <td><%= row['oppName2'] %></td>
          <td><%= row['score'] %></td>
          <td><%= row['vsScore'] %></td>
          <td><%= row['gameType'] %></td>
          <%# A game with no rating — a void fixture, or one the backfill never reached — is
              stored as 0, and a 0 here read as a rating of zero. %>
          <% var rated = row['after'] > 0 %>
          <td><%= rated ? row['beforeVal'] : '–' %></td>
          <td><%= rated ? row['after'] : '–' %></td>
          <td><%= rated ? row['adjustment'] : '–' %></td>
      </tr>
    <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
   <% } %>

</div><!-- /col-12 -->

<%- include('footer.ejs') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<% if (result && result.length > 0) { %>
<script>
  (function() {
    var allPoints = <%- JSON.stringify(
      result.slice().reverse()
        .filter(function(r){ return r.after && r.after > 0 })
        .map(function(r){
          return {
            x: new Date(r.date).toISOString().slice(0,10),
            y: r.after,
            tip: (r.partnerName || '') + ' vs ' + (r.oppName1 || '') + ' / ' + (r.oppName2 || '') +
                 '  (' + r.score + '–' + r.vsScore + ')  ' +
                 (r.adjustment > 0 ? '+' : '') + r.adjustment
          }
        })
    ) %>;

    // One point per fixture date: keep the last game played that night so the
    // chart shows a clean "end-of-fixture rating" trend rather than per-game zigzags.
    var byDate = {};
    allPoints.forEach(function(pt) { byDate[pt.x] = pt; });
    var raw = Object.keys(byDate).sort().map(function(k) { return byDate[k]; });

    var points = <%- JSON.stringify(typeof strength !== 'undefined' && strength ? strength.data : []) %>;
    // No line or shading across a gap longer than a summer (2020/21 had no games).
    function hideLongGap(ctx) {
      return ctx.p1.parsed.x - ctx.p0.parsed.x > 200 * 86400000 ? 'transparent' : undefined;
    }

    new Chart(document.getElementById('elo-chart'), {
      type: 'line',
      data: {
        datasets: [{
          label: '<%- fullName %> ELO',
          data: raw,
          borderColor: '#007bff',
          backgroundColor: 'rgba(0,123,255,0.08)',
          fill: true,
          tension: 0,
          pointRadius: 3,
          pointHoverRadius: 6
        }].concat(points.length ? [{
          // The band: the rating ± its standard error, shaded between two invisible lines.
          band: true,
          data: points.map(function(d){ return { x: d.x, y: d.y + d.se } }),
          borderWidth: 0, pointRadius: 0, pointHoverRadius: 0, fill: false, tension: 0,
          segment: { backgroundColor: hideLongGap }
        }, {
          band: true,
          data: points.map(function(d){ return { x: d.x, y: d.y - d.se } }),
          borderWidth: 0, pointRadius: 0, pointHoverRadius: 0, tension: 0,
          fill: '-1',
          backgroundColor: 'rgba(108,117,125,0.15)',
          segment: { backgroundColor: function(ctx) { return hideLongGap(ctx) || 'rgba(108,117,125,0.15)'; } }
        }, {
          label: 'Points rating',
          data: points,
          borderColor: '#6c757d',
          backgroundColor: '#6c757d',
          borderDash: [6, 4],
          // No line across a gap longer than a summer (2020/21 had no games).
          segment: { borderColor: hideLongGap },
          fill: false,
          tension: 0,
          pointRadius: 0,
          pointHoverRadius: 4
        }] : [])
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: {
            type: 'time',
            time: { unit: 'month', tooltipFormat: 'dd MMM yyyy' },
            title: { display: false }
          },
          y: {
            title: { display: true, text: points.length ? 'Rating' : 'ELO Rating' }
          }
        },
        plugins: {
          legend: { display: points.length > 0, labels: { filter: function(item, data) { return !data.datasets[item.datasetIndex].band; } } },
          tooltip: {
            filter: function(item) { return !item.dataset.band; },
            callbacks: {
              label: function(ctx) {
                if (ctx.dataset.label === 'Points rating') return 'Points rating: ' + ctx.raw.y + ' (±' + ctx.raw.se + ')';
                return 'Rating: ' + ctx.raw.y + '  |  ' + ctx.raw.tip;
              }
            }
          }
        }
      }
    });
  })();
</script>
<% } %>
<%- include('datatables.ejs', { dtCsv: true }) %>

</body>
</html>
