{
  "name": "Elastic-Beanstalk-Sample-App",
  "version": "0.0.1",
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.696.0",
    "@aws-sdk/client-ses": "^3.696.0",
    "@aws-sdk/client-sesv2": "^3.696.0",
    "@aws-sdk/s3-request-presigner": "^3.696.0",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@google-cloud/vision": "^5.3.6",
    "@sentry/node": "^10.66.0",
    "async": "^2.5.0",
    "axios": "^1.20.0",
    "body-parser": "^1.20.9",
    "bootstrap": "^4.1.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "connect-ensure-login": "^0.1.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.3",
    "docx": "^8.2.3",
    "dotenv": "^10.0.0",
    "ejs": "^3.1.8",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.15.6",
    "express-validator": "^6.14.2",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^8.3.0",
    "ical.js": "^1.5.0",
    "jquery": "^3.3.1",
    "js-levenshtein": "^1.1.6",
    "jsonpath": "^1.1.1",
    "kysely": "^0.28.18",
    "mailparser": "^3.9.47",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.7",
    "passport": "^0.6.0",
    "passport-auth0": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "pino": "^10.4.0",
    "popper.js": "^1.14.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "2.17.5",
    "sharp": "^0.35.5"
  },
  "scripts": {
    "start": "node app.js",
    "prodlocal": "ALLOW_PRODUCTION_DB=i-know-what-i-am-doing nodemon -r dotenv/config app.js dotenv_config_path=./.env",
    "dev": "nodemon -r dotenv/config app.js dotenv_config_path=./dev.env",
    "gallery": "nodemon ./views/beta/gallery.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "jest && playwright test",
    "build:email": "node tools/build-emails.js",
    "build:email:check": "node tools/build-emails.js --check",
    "preview:email": "node tools/preview-emails.js",
    "test:db": "jest -c jest.db.config.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:types": "node tools/db-types.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./__tests__/setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/\\.claude/",
      "<rootDir>/__tests__/db/"
    ],
    "testTimeout": 15000,
    "workerIdleMemoryLimit": "800MB",
    "setupFilesAfterEnv": [
      "./__tests__/setupAfterEnv.js"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.4.2",
    "kysely-codegen": "^0.20.0",
    "mjml": "^5.4.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "underscore": "^1.13.8",
    "uuid": "^11.1.1"
  }
}
